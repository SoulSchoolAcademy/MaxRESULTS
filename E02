<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="#000"><title>MAXESS — E02</title><style>#e02{min-height:100vh;background:#000;color:#fff;font-family:Inter,system-ui,sans-serif;padding:70px 20px 90px;box-sizing:border-box}#e02 *{box-sizing:border-box}.e02-shell{width:min(1050px,100%);margin:auto}.e02-head{text-align:center}.e02-kicker{font-size:10px;letter-spacing:.3em;color:#aaa3b5;font-weight:900}.e02-title{font:400 clamp(38px,6vw,66px)/1 Georgia,serif;margin:15px 0}.e02-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:24px;margin-top:55px}.e02-card{text-align:center}.e02-orb{width:150px;max-width:100%;aspect-ratio:1;margin:auto;border-radius:50%;display:grid;place-items:center;background:radial-gradient(circle,#241436,#09060d 70%);border:1px solid rgba(195,168,255,.45);box-shadow:0 0 42px rgba(149,104,255,.2),inset 0 0 35px rgba(149,104,255,.12)}.e02-score{font-size:38px;font-weight:950}.e02-name{margin-top:17px;font-size:11px;font-weight:900;letter-spacing:.16em}.e02-status{margin-top:7px;color:#aaa3b5;font-size:10px;text-transform:uppercase;letter-spacing:.12em}.e02-wait{margin-top:35px;text-align:center;color:#8e8998;font-size:10px;letter-spacing:.15em;text-transform:uppercase}@media(max-width:820px){.e02-grid{grid-template-columns:repeat(2,1fr);gap:28px 14px}}@media(max-width:420px){#e02{padding:50px 12px}.e02-grid{grid-template-columns:repeat(2,1fr)}.e02-orb{width:125px}.e02-score{font-size:31px}.e02-name{font-size:9px}}@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}</style></head><body><section id="e02"><div class="e02-shell"><header class="e02-head"><div class="e02-kicker">YOUR CAPABILITY PROFILE</div><h2 class="e02-title">Your capability constellation</h2></header><div class="e02-grid" id="e02-grid"></div><div class="e02-wait" id="e02-wait">Awaiting your MAXESS result</div></div></section><script>'use strict';
function readResult(){const c=[];try{c.push(window.MAXESS_RESULT)}catch(e){}try{if(window.parent&&window.parent!==window)c.push(window.parent.MAXESS_RESULT)}catch(e){}try{if(window.top&&window.top!==window)c.push(window.top.MAXESS_RESULT)}catch(e){}for(const r of c)if(r&&r.contractVersion==='MAXESS_RESULT_V1')return r;for(const store of [sessionStorage,localStorage])try{const r=JSON.parse(store.getItem('MAXESS_RESULT_V1')||'null');if(r&&r.contractVersion==='MAXESS_RESULT_V1')return r}catch(e){}try{const raw=new URLSearchParams(location.hash.replace(/^#/,'' )).get('maxess-result');if(raw){const s=raw.replace(/-/g,'+').replace(/_/g,'/');const bin=atob(s.padEnd(s.length+((4-s.length%4)%4),'='));const r=JSON.parse(new TextDecoder().decode(Uint8Array.from(bin,c=>c.charCodeAt(0))));if(r&&r.contractVersion==='MAXESS_RESULT_V1')return r}}catch(e){}return null}function onResult(fn){fn(readResult());['MAXESS_RESULT_READY','maxess:result-updated','storage','hashchange'].forEach(n=>window.addEventListener(n,e=>fn(e&&e.detail||readResult())));let i=0;const t=setInterval(()=>{fn(readResult());if(readResult()||++i>40)clearInterval(t)},250)}const dims=[['direction','DIRECTION'],['context','CONTEXT'],['collaboration','COLLABORATION'],['evaluation','EVALUATION'],['iteration','ITERATION']];function scoreFor(r,id,i){if(!r||!Array.isArray(r.dimensions))return null;const d=r.dimensions.find(x=>String(x.id||'').toLowerCase()===id||String(x.name||'').toLowerCase()===id);const v=d&&d.score!==undefined?d.score:r.dimensions[i]&&r.dimensions[i].score;return Number.isFinite(Number(v))?Math.max(0,Math.min(100,Number(v))):null}function render(r){const g=document.getElementById('e02-grid');g.innerHTML=dims.map((d,i)=>{const s=scoreFor(r,d[0],i);return '<div class="e02-card"><div class="e02-orb"><div class="e02-score">'+(s===null?'—':Math.round(s))+'</div></div><div class="e02-name">'+d[1]+'</div><div class="e02-status">'+(s===null?'AWAITING DATA':s<50?'EMERGING':s<75?'DEVELOPING':s<90?'ADVANCING':'MASTERING')+'</div></div>'}).join('');document.getElementById('e02-wait').hidden=!!r}onResult(render);</script></body></html>