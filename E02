<section id="maxess-e02-v2">

<style> #maxess-e02-v2, #maxess-e02-v2 * { box-sizing:border-box; } #maxess-e02-v2 { --e02-purple:#a66cff; --e02-coral:#ff557d; --e02-emerald:#28d89a; --e02-blue:#4194ff; --e02-gold:#edc15a; width:100vw; max-width:100vw; margin-left:calc(50% - 50vw); position:relative; overflow:hidden; isolation:isolate; background: radial-gradient( ellipse 80% 55% at 50% 0%, rgba(166,108,255,.10), transparent 70% ), linear-gradient( 180deg, #05030a 0%, #020107 100% ); color:#fff; font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; padding: clamp(70px,8vw,110px) 20px clamp(90px,10vw,140px); }
#maxess-e02-v2 .e02-header { width:100%; max-width:1200px; margin:0 auto clamp(50px,6vw,75px); text-align:center; }
#maxess-e02-v2 .e02-kicker { margin:0 0 14px; color:rgba(255,255,255,.48); font-size:10px; font-weight:900; letter-spacing:.30em; text-transform:uppercase; }
#maxess-e02-v2 .e02-title { margin:0; color:#fff; font-size:clamp(25px,3vw,40px); line-height:1.05; font-weight:900; letter-spacing:-.045em; }
#maxess-e02-v2 .e02-grid { width:100%; max-width:1280px; margin:0 auto; display:grid; grid-template-columns:repeat(5,minmax(0,1fr)); align-items:start; justify-content:center; gap:clamp(14px,2.5vw,42px); }
#maxess-e02-v2 .e02-dimension { min-width:0; display:flex; flex-direction:column; align-items:center; text-align:center; }
#maxess-e02-v2 .e02-orb-stage { width:100%; max-width:190px; aspect-ratio:1; position:relative; display:grid; place-items:center; }
