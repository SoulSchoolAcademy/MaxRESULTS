#maxess-e02-v2 .e02-ring { position:absolute; inset:5%; border-radius:50%; border:1px solid color-mix(in srgb,var(--e02-color) 55%,rgba(255,255,255,.15)); box-shadow:0 0 35px color-mix(in srgb,var(--e02-color) 20%,transparent); }
#maxess-e02-v2 .e02-orb { width:78%; height:78%; position:relative; display:grid; place-items:center; border-radius:50%; background:radial-gradient(circle at 30% 18%,rgba(255,255,255,.28),transparent 13%),radial-gradient(circle at 38% 34%,color-mix(in srgb,var(--e02-color) 25%,transparent),transparent 42%),radial-gradient(circle at 50% 50%,#17121d 0%,#09070d 68%,#020107 100%); border:1px solid rgba(255,255,255,.22); box-shadow:inset 10px 10px 30px rgba(255,255,255,.06),inset -25px -30px 55px rgba(0,0,0,.78),inset 0 0 55px color-mix(in srgb,var(--e02-color) 16%,transparent),0 25px 55px rgba(0,0,0,.65),0 0 45px color-mix(in srgb,var(--e02-color) 18%,transparent); animation:maxess-e02-v2-breathe 6s ease-in-out infinite; }
#maxess-e02-v2 .e02-core { position:absolute; width:38%; height:38%; border-radius:50%; background:radial-gradient(circle at 35% 30%,rgba(255,255,255,.32),color-mix(in srgb,var(--e02-color) 28%,transparent) 30%,transparent 72%); filter:blur(1px); animation:maxess-e02-v2-core 3.5s ease-in-out infinite; }
#maxess-e02-v2 .e02-score { position:relative; z-index:10; color:#fff; font-size:clamp(34px,4vw,58px); line-height:1; font-weight:950; letter-spacing:-.075em; text-shadow:0 2px 0 #000,0 4px 10px rgba(0,0,0,.95),0 0 24px color-mix(in srgb,var(--e02-color) 65%,transparent); user-select:none; }
#maxess-e02-v2 .e02-orbit { position:absolute; inset:5%; border-radius:50%; animation:maxess-e02-v2-orbit 10s linear infinite; }
#maxess-e02-v2 .e02-bead { position:absolute; top:0; left:50%; width:8px; height:8px; transform:translate(-50%,-50%); border-radius:50%; background:radial-gradient(circle at 30% 25%,#fff 0%,#fff 18%,var(--e02-color) 48%,#111 100%); box-shadow:0 0 7px #fff,0 0 18px var(--e02-color); }
#maxess-e02-v2 .e02-name { width:100%; margin-top:clamp(18px,2vw,25px); color:#fff; font-size:clamp(9px,1vw,12px); line-height:1.25; font-weight:900; letter-spacing:.14em; text-transform:uppercase; text-align:center; }
#maxess-e02-v2 .e02-dimension:nth-child(1){--e02-color:var(--e02-purple)} #maxess-e02-v2 .e02-dimension:nth-child(2){--e02-color:var(--e02-coral)} #maxess-e02-v2 .e02-dimension:nth-child(3){--e02-color:var(--e02-emerald)} #maxess-e02-v2 .e02-dimension:nth-child(4){--e02-color:var(--e02-blue)} #maxess-e02-v2 .e02-dimension:nth-child(5){--e02-color:var(--e02-gold)}
@keyframes maxess-e02-v2-breathe{0%,100%{transform:scale(1)}50%{transform:scale(1.018)}} @keyframes maxess-e02-v2-core{0%,100%{transform:scale(.94);opacity:.78}50%{transform:scale(1.06);opacity:1}} @keyframes maxess-e02-v2-orbit{from{transform:rotate(0deg)}to{transform:rotate(360deg)}}
@media (max-width:900px){#maxess-e02-v2 .e02-grid{grid-template-columns:repeat(3,minmax(0,1fr));max-width:720px;row-gap:50px}#maxess-e02-v2 .e02-dimension:nth-child(4){grid-column:1}#maxess-e02-v2 .e02-dimension:nth-child(5){grid-column:2}}
@media (max-width:600px){#maxess-e02-v2{padding:65px 12px 85px}#maxess-e02-v2 .e02-grid{grid-template-columns:repeat(6,minmax(0,1fr));max-width:430px;gap:40px 4px}#maxess-e02-v2 .e02-dimension:nth-child(1){grid-column:1/3}#maxess-e02-v2 .e02-dimension:nth-child(2){grid-column:3/5}#maxess-e02-v2 .e02-dimension:nth-child(3){grid-column:5/7}#maxess-e02-v2 .e02-dimension:nth-child(4){grid-column:2/4}#maxess-e02-v2 .e02-dimension:nth-child(5){grid-column:4/6}#maxess-e02-v2 .e02-orb-stage{max-width:125px}#maxess-e02-v2 .e02-name{margin-top:14px;font-size:8px;letter-spacing:.085em}#maxess-e02-v2 .e02-score{font-size:30px}}
@media (prefers-reduced-motion:reduce){#maxess-e02-v2 .e02-orb,#maxess-e02-v2 .e02-core,#maxess-e02-v2 .e02-orbit{animation:none!important}}
</style>
<div class="e02-header"><div class="e02-kicker">YOUR CAPABILITY PROFILE</div><h2 class="e02-title">Your capability constellation</h2></div>
<div class="e02-grid">
<div class="e02-dimension"><div class="e02-orb-stage"><div class="e02-glow"></div><div class="e02-ring"></div><div class="e02-orb"><div class="e02-core"></div><div class="e02-score" data-score="">—</div></div><div class="e02-orbit"><div class="e02-bead"></div></div></div><div class="e02-name">DIRECTION</div></div>
<div class="e02-dimension"><div class="e02-orb-stage"><div class="e02-glow"></div><div class="e02-ring"></div><div class="e02-orb"><div class="e02-core"></div><div class="e02-score" data-score="">—</div></div><div class="e02-orbit"><div class="e02-bead"></div></div></div><div class="e02-name">COMMUNICATION</div></div>
<div class="e02-dimension"><div class="e02-orb-stage"><div class="e02-glow"></div><div class="e02-ring"></div><div class="e02-orb"><div class="e02-core"></div><div class="e02-score" data-score="">—</div></div><div class="e02-orbit"><div class="e02-bead"></div></div></div><div class="e02-name">EVALUATION</div></div>
<div class="e02-dimension"><div class="e02-orb-stage"><div class="e02-glow"></div><div class="e02-ring"></div><div class="e02-orb"><div class="e02-core"></div><div class="e02-score" data-score="">—</div></div><div class="e02-orbit"><div class="e02-bead"></div></div></div><div class="e02-name">ITERATION</div></div>
<div class="e02-dimension"><div class="e02-orb-stage"><div class="e02-glow"></div><div class="e02-ring"></div><div class="e02-orb"><div class="e02-core"></div><div class="e02-score" data-score="">—</div></div><div class="e02-orbit"><div class="e02-bead"></div></div></div><div class="e02-name">SYSTEMS THINKING</div></div>
</div>
<script>
(() => {
  "use strict";
  const root=document.getElementById("maxess-e02-v2");
  if(!root)return;
  const scoreNodes=Array.from(root.querySelectorAll(".e02-score"));
  const dimensions=["DIRECTION","COMMUNICATION","EVALUATION","ITERATION","SYSTEMS THINKING"];
  const CONTRACT="MAXESS_RESULT_V1";
  const STORAGE_KEY="MAXESS_RESULT_V1";
  const HASH_KEY="maxess-result";
  let lastSignature="";

  function clampScore(value){
    if(value===null||value===undefined||value==="")return null;
    const number=Number(value);
    return Number.isFinite(number)?Math.max(0,Math.min(100,number)):null;
  }
  function normalize(value){return String(value||"").toLowerCase().replace(/[^a-z0-9]/g,"");}
  function decodeBase64Url(value){
    let normalized=String(value||"").replace(/-/g,"+").replace(/_/g,"/");
    while(normalized.length%4)normalized+="=";
    const binary=atob(normalized);
    let encoded="";
    for(let i=0;i<binary.length;i++)encoded+="%"+("00"+binary.charCodeAt(i).toString(16)).slice(-2);
    return decodeURIComponent(encoded);
  }
  function validResult(result){
    return !!(result&&typeof result==="object"&&result.contractVersion===CONTRACT&&Number.isFinite(Number(result.overallScore))&&Number(result.overallScore)>=0&&Number(result.overallScore)<=100&&Array.isArray(result.dimensions)&&result.dimensions.length===5);
  }
  function readHashResult(){
    try{
      const hash=window.location.hash||"";
      const match=hash.match(/(?:^|#|&)maxess-result=([^&]+)/i);
      if(!match)return null;
      const result=JSON.parse(decodeBase64Url(decodeURIComponent(match[1])));
      return validResult(result)?result:null;
    }catch(error){return null;}
  }
  function readStorageResult(){
    const stores=[];
    try{stores.push(window.sessionStorage)}catch(error){}
    try{stores.push(window.localStorage)}catch(error){}
    for(const store of stores){
      try{
        const raw=store.getItem(STORAGE_KEY);
        if(raw){const result=JSON.parse(raw);if(validResult(result))return result;}
      }catch(error){}
    }
    return null;
  }
  function readWindowResult(){
    const sources=[];
    try{sources.push(window.MAXESS_RESULT)}catch(error){}
    try{if(window.parent&&window.parent!==window)sources.push(window.parent.MAXESS_RESULT)}catch(error){}
    try{if(window.top&&window.top!==window&&window.top!==window.parent)sources.push(window.top.MAXESS_RESULT)}catch(error){}
    for(const result of sources)if(validResult(result))return result;
    return null;
  }
  function readResult(){return readWindowResult()||readStorageResult()||readHashResult();}
  function signature(result){
    if(!result)return "";
    return [result.contractVersion,result.overallScore,result.dimensions.map(d=>String(d&&d.name||d&&d.id||"")+":"+String(d&&d.score||"")).join("|")].join("::");
  }
  function publish(result){
    if(!validResult(result))return null;
    window.MAXESS_RESULT=result;
    try{window.sessionStorage.setItem(STORAGE_KEY,JSON.stringify(result));}catch(error){}
    return result;
  }
  function readDimensionScore(result,dimensionName,index){
    if(!result||!Array.isArray(result.dimensions))return null;
    const target=normalize(dimensionName);
    for(const dimension of result.dimensions){
      if(!dimension||typeof dimension!=="object")continue;
      const identity=normalize(dimension.id||dimension.dimensionId||dimension.name||dimension.label||dimension.title);
      if(identity===target)return clampScore(dimension.score!==undefined?dimension.score:dimension.value!==undefined?dimension.value:dimension.overallScore);
    }
    const fallback=result.dimensions[index];
    if(fallback&&typeof fallback==="object")return clampScore(fallback.score!==undefined?fallback.score:fallback.value!==undefined?fallback.value:fallback.overallScore);
    return clampScore(fallback);
  }
  function render(){
    let result=readResult();
    if(result)result=publish(result);
    const nextSignature=signature(result);
    scoreNodes.forEach((node,index)=>{
      const score=readDimensionScore(result,dimensions[index],index);
      node.textContent=score===null?"—":Number.isInteger(score)?String(score):String(Math.round(score*10)/10);
      node.dataset.score=score===null?"":String(score);
      node.dataset.demo="false";
      node.setAttribute("aria-label",score===null?dimensions[index]+" score unavailable":dimensions[index]+" score "+node.textContent+" out of 100");
    });
    if(nextSignature!==lastSignature){lastSignature=nextSignature;}
    return !!result;
  }
  function consume(){return render();}
  render();
  window.addEventListener("maxess:result-updated",consume);
  window.addEventListener("MAXESS_RESULT_READY",consume);
  window.addEventListener("storage",consume);
  window.addEventListener("hashchange",consume);
  window.addEventListener("pageshow",consume);
  let attempts=0;
  const hydrationPoll=setInterval(()=>{attempts+=1;if(render()||attempts>=120)clearInterval(hydrationPoll);},250);
  window.MAXESS_E02_RESULT_BRIDGE={consume,read:readResult,contractVersion:CONTRACT,storageKey:STORAGE_KEY};
})();
</script>
</section>
<script data-maxess-result-consumer="v3">
(function(){
  'use strict';
  if(window.__MAXESS_RESULT_CONSUMER_V3__) return;
  window.__MAXESS_RESULT_CONSUMER_V3__ = true;

  var CONTRACT='MAXESS_RESULT_V1';
  var READY='MAXESS_RESULT_READY';
  var UPDATED='maxess:result-updated';
  var STORAGE_KEY='MAXESS_RESULT_V1';
  var lastSignature='';
  var timer=null;
  var attempts=0;

  function emit(name, detail){
    try{ window.dispatchEvent(new CustomEvent(name,{detail:detail||null})); }
    catch(e){ try{ window.dispatchEvent(new Event(name)); }catch(_){} }
  }

  function decode(value){
    var s=String(value||'').replace(/-/g,'+').replace(/_/g,'/');
    while(s.length%4) s+='=';
    var binary=atob(s), bytes='';
    for(var i=0;i<binary.length;i++) bytes+='%'+('00'+binary.charCodeAt(i).toString(16)).slice(-2);
    return decodeURIComponent(bytes);
  }

  function payload(){
    var hash=window.location.hash||'';
    var m=hash.match(/(?:^#|&)maxess-result=([^&]+)/i);
    if(!m) return null;
    try{return decodeURIComponent(m[1]);}catch(e){return m[1];}
  }

  function valid(r){
    if(!r||typeof r!=='object'||r.contractVersion!==CONTRACT) return false;
    var overall=Number(r.overallScore);
    if(!Number.isFinite(overall)||overall<0||overall>100) return false;
    if(!Array.isArray(r.dimensions)||r.dimensions.length!==5) return false;
    if(!Array.isArray(r.responses)||r.responses.length!==15) return false;
    for(var i=0;i<5;i++){
      var d=r.dimensions[i];
      if(!d||typeof d.name!=='string'||!d.name.trim()) return false;
      var score=Number(d.score);
      if(!Number.isFinite(score)||score<0||score>100) return false;
    }
    return true;
  }

  function sig(r){
    try{return [r.contractVersion,Number(r.overallScore),r.masteryBand||'',r.dimensions.map(function(d){return String(d.name)+':'+Number(d.score);}).join('|'),r.responses.length].join('::');}
    catch(e){return '';}
  }

  function publish(r,source,force){
    if(!valid(r)) return false;
    var s=sig(r), changed=s!==lastSignature;
    window.MAXESS_RESULT=r;
    try{sessionStorage.setItem(STORAGE_KEY,JSON.stringify(r));}catch(e){}
    if(changed||force){
      lastSignature=s;
      emit(READY,{result:r,source:source||'hash'});
      emit(UPDATED,{result:r,source:source||'hash'});
    }
    return true;
  }

  function consume(){
    var raw=payload();
    if(raw){
      try{var r=JSON.parse(raw);if(publish(r,'hash',false)) return true;}catch(e){}
    }
    try{var stored=JSON.parse(sessionStorage.getItem(STORAGE_KEY)||'null');if(publish(stored,'session',false)) return true;}catch(e){}
    return false;
  }

  function run(){
    var ok=consume();
    if(ok) emit(UPDATED,{result:window.MAXESS_RESULT,source:'hydration'});
    attempts++;
    if(attempts<80) timer=window.setTimeout(run,250);
  }

  window.MAXESS_RESULT_CONSUMER_V3={consume:consume,get:function(){return window.MAXESS_RESULT||null;},contractVersion:CONTRACT,version:'V3'};
  window.addEventListener('hashchange',function(){attempts=0;lastSignature='';if(timer)clearTimeout(timer);run();});
  window.addEventListener('pageshow',function(){attempts=0;run();});
  if(document.readyState==='loading') document.addEventListener('DOMContentLoaded',function(){attempts=0;run();},{once:true});
  else run();
})();
</script>
