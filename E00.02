<style id="MAXESS-ISOLATION-V7-CSS">

/* MAXESS ISOLATION V7
   E00.02 owns visibility only.
   E00.03 owns the release decision. */

html[data-maxess-results-state="waiting"] #e00,
html[data-maxess-results-state="waiting"] .maxess-e00,
html[data-maxess-results-state="waiting"] [data-maxess-e00] {
  width:100% !important;
  max-width:none !important;
  min-width:0 !important;
  margin-left:auto !important;
  margin-right:auto !important;
  flex:0 0 100% !important;
  align-self:stretch !important;
  box-sizing:border-box !important;
}

html[data-maxess-results-state="waiting"] #e00 .app,
html[data-maxess-results-state="waiting"] #e00 .shell,
html[data-maxess-results-state="waiting"] #e00 .board,
html[data-maxess-results-state="waiting"] #e00 .content {
  width:100% !important;
  max-width:100% !important;
  min-width:0 !important;
}

html[data-maxess-results-state="waiting"] #e01,
html[data-maxess-results-state="waiting"] #maxess-e02-v3,
html[data-maxess-results-state="waiting"] #e03,
html[data-maxess-results-state="waiting"] #e04,
html[data-maxess-results-state="waiting"] #e05,
html[data-maxess-results-state="waiting"] #e06,
html[data-maxess-results-state="waiting"] #e07,
html[data-maxess-results-state="waiting"] #e08,
html[data-maxess-results-state="waiting"] #e09,
html[data-maxess-results-state="waiting"] [data-maxess-result-section],
html[data-maxess-results-state="waiting"] .maxess-result-section {
  display:none !important;
}

html[data-maxess-results-state="released"] [data-maxess-result-section],
html[data-maxess-results-state="released"] .maxess-result-section {
  display:block !important;
}

html[data-maxess-results-state="waiting"] body {
  width:100% !important;
  max-width:100% !important;
  overflow-x:hidden !important;
}

</style>

<script id="MAXESS-ISOLATION-V7">
(function () {
  'use strict';

  if (window.__MAXESS_ISOLATION_V7__) return;
  window.__MAXESS_ISOLATION_V7__ = true;

  const ROOT_STATE = 'data-maxess-results-state';
  let released = false;
  let scrolled = false;
  let observer = null;

  function markWaiting() {
    if (!released) {
      document.documentElement.setAttribute(ROOT_STATE, 'waiting');
    }
  }

  function findSections() {
    return [
      document.getElementById('e01'),
      document.getElementById('maxess-e02-v3'),
      document.getElementById('e03'),
      document.getElementById('e04'),
      document.getElementById('e05'),
      document.getElementById('e06'),
      document.getElementById('e07'),
      document.getElementById('e08'),
      document.getElementById('e09')
    ].filter(Boolean);
  }

  function markResultSections() {
    findSections().forEach(function (section) {
      section.setAttribute('data-maxess-result-section', '');
      section.classList.add('maxess-result-section');
    });
  }

  function validResult(result) {
    return !!(
      result &&
      result.contractVersion === 'MAXESS_RESULT_V1' &&
      Number.isInteger(result.overallScore) &&
      result.overallScore >= 0 &&
      result.overallScore <= 100 &&
      Array.isArray(result.dimensions) &&
      result.dimensions.length === 5 &&
      Array.isArray(result.responses) &&
      result.responses.length === 15
    );
  }

  function stopObserver() {
    if (observer) {
      observer.disconnect();
      observer = null;
    }
  }

  function release(result) {
    if (released || !validResult(result)) return false;

    /* Mark sections before changing the root state so a newly injected
       Groove section is already classified when the release becomes visible. */
    markResultSections();
    released = true;
    document.documentElement.setAttribute(ROOT_STATE, 'released');

    const e00 =
      document.getElementById('e00') ||
      document.querySelector('[data-maxess-e00]') ||
      document.querySelector('.maxess-e00');

    if (e00) {
      e00.style.width = '100%';
      e00.style.maxWidth = 'none';
      e00.style.minWidth = '0';
    }

    if (!scrolled) {
      const first = document.getElementById('e01');
      if (first) {
        scrolled = true;
        setTimeout(function () {
          try {
            first.scrollIntoView({ behavior:'smooth', block:'start' });
          } catch (error) {
            try { first.scrollIntoView(); } catch (ignored) {}
          }
        }, 80);
      }
    }

    stopObserver();
    console.log('[MAXESS ISOLATION] Results released:', result.overallScore);
    return true;
  }

  function initialize() {
    markWaiting();
    markResultSections();

    /* Groove may inject result sections after initialization. Keep the
       classifier live until the authoritative release arrives. */
    if (window.MutationObserver) {
      observer = new MutationObserver(function () {
        if (!released) markResultSections();
      });

      observer.observe(document.body || document.documentElement, {
        childList:true,
        subtree:true
      });
    }
  }

  window.addEventListener('MAXESS_ISOLATION_RELEASE', function (event) {
    const result = event && event.detail && event.detail.result;
    release(result);
  });

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initialize, { once:true });
  } else {
    initialize();
  }
})();
</script>
