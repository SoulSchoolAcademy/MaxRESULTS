<!-- ============================================================
     E00.03 — MAXESS RESULTS RELEASE AUTHORITY V2
     MAXESS_RESULT_V1

     NORTH STAR:
       A valid MAXESS result is released exactly once.

     RESPONSIBILITIES:
       - Receive the canonical result from E00.01.
       - Validate the complete minimum contract.
       - Own the ONLY Results release decision.
       - Emit MAXESS_ISOLATION_RELEASE exactly once.
       - Never calculate, mutate, or invent a result.
       - Never render Results UI.

     FLOW:
       E00 → E00.01 (canonical data bridge)
          → E00.03 (release authority)
          → E00.02 (visual isolation)
          → E01–E09
     ============================================================ -->

<div
  id="MAXESS_E00_03_RESULTS_CONTROLLER"
  aria-hidden="true"
  style="display:none!important;width:0!important;height:0!important;overflow:hidden!important;position:absolute!important;left:-99999px!important;top:-99999px!important;pointer-events:none!important;opacity:0!important;visibility:hidden!important;"
></div>

<script id="MAXESS-E00-03-RELEASE-AUTHORITY-V2">
(function () {
  'use strict';

  if (window.__MAXESS_E00_03_RELEASE_AUTHORITY_V2__) return;
  window.__MAXESS_E00_03_RELEASE_AUTHORITY_V2__ = true;

  const VERSION = '2.0.0';
  const CONTRACT = 'MAXESS_RESULT_V1';
  const OFFICIAL_EVENT = 'MAXESS_OFFICIAL_RESULT_READY';
  const RELEASE_EVENT = 'MAXESS_ISOLATION_RELEASE';

  let released = false;
  let officialResult = null;
  let recoveryTimer = null;
  let recoveryAttempts = 0;
  const MAX_RECOVERY_ATTEMPTS = 120;
  const RECOVERY_INTERVAL_MS = 100;

  function isValidResult(result) {
    if (!result || typeof result !== 'object') return false;
    if (result.contractVersion !== CONTRACT) return false;

    if (
      !Number.isInteger(result.overallScore) ||
      result.overallScore < 0 ||
      result.overallScore > 100
    ) return false;

    if (
      !['foundation', 'developing', 'advancing', 'mastery'].includes(result.masteryBand)
    ) return false;

    if (!Array.isArray(result.dimensions) || result.dimensions.length !== 5) return false;
    if (!Array.isArray(result.responses) || result.responses.length !== 15) return false;

    return true;
  }

  function cloneResult(result) {
    try {
      return JSON.parse(JSON.stringify(result));
    } catch (error) {
      console.error('[E00.03] Result clone failed.', error);
      return null;
    }
  }

  function getCanonicalResult() {
    if (
      window.MAXESS_E00_01 &&
      typeof window.MAXESS_E00_01.getResult === 'function'
    ) {
      try {
        const bridgeResult = window.MAXESS_E00_01.getResult();
        if (isValidResult(bridgeResult)) return bridgeResult;
      } catch (error) {
        console.warn('[E00.03] E00.01 getResult() failed.', error);
      }
    }

    if (isValidResult(window.MAXESS_OFFICIAL_RESULT)) {
      return window.MAXESS_OFFICIAL_RESULT;
    }

    return null;
  }

  function clearRecovery() {
    if (recoveryTimer !== null) {
      clearTimeout(recoveryTimer);
      recoveryTimer = null;
    }
  }

  function release(result) {
    if (released) return true;
    if (!isValidResult(result)) return false;

    const safeResult = cloneResult(result);
    if (!safeResult) return false;

    officialResult = safeResult;
    released = true;
    clearRecovery();

    window.MAXESS_RESULTS_RELEASED = true;
    window.MAXESS_RESULTS_CONTROLLER = {
      version: VERSION,
      contractVersion: CONTRACT,
      released: true,
      result: officialResult
    };

    window.dispatchEvent(
      new CustomEvent(RELEASE_EVENT, {
        detail: {
          result: officialResult,
          contractVersion: CONTRACT,
          controllerVersion: VERSION,
          source: 'E00.03'
        }
      })
    );

    window.dispatchEvent(
      new CustomEvent('MAXESS_RESULTS_RELEASED', {
        detail: {
          result: officialResult,
          contractVersion: CONTRACT,
          source: 'E00.03'
        }
      })
    );

    /* Groove/embed compatibility: notify the containing frame.
       This is outbound only; inbound release authority remains E00.03. */
    const message = {
      type: RELEASE_EVENT,
      contractVersion: CONTRACT,
      controllerVersion: VERSION,
      result: officialResult,
      source: 'E00.03'
    };

    try {
      if (window.parent && window.parent !== window) {
        window.parent.postMessage(message, '*');
      }
    } catch (error) {}

    try {
      if (window.top && window.top !== window && window.top !== window.parent) {
        window.top.postMessage(message, '*');
      }
    } catch (error) {}

    console.log('[E00.03] RESULTS RELEASED', {
      overallScore: officialResult.overallScore,
      masteryBand: officialResult.masteryBand
    });

    return true;
  }

  function recover() {
    if (released) {
      clearRecovery();
      return;
    }

    const result = getCanonicalResult();
    if (result) {
      release(result);
      return;
    }

    recoveryAttempts += 1;
    if (recoveryAttempts >= MAX_RECOVERY_ATTEMPTS) {
      clearRecovery();
      console.warn('[E00.03] No canonical MAXESS_RESULT_V1 found during bounded recovery.');
      return;
    }

    recoveryTimer = setTimeout(recover, RECOVERY_INTERVAL_MS);
  }

  /* E00.01 is the ONLY upstream source accepted for normal release. */
  window.addEventListener(OFFICIAL_EVENT, function (event) {
    const result = event && event.detail;
    if (isValidResult(result)) release(result);
  });

  /* Cross-frame compatibility. Only accept a valid result from the
     immediate parent/top frame; never treat arbitrary window messages
     as authoritative. */
  window.addEventListener('message', function (event) {
    if (!event || !event.source) return;

    const parentWindow = window.parent;
    const topWindow = window.top;
    if (event.source !== parentWindow && event.source !== topWindow) return;

    const data = event.data;
    if (!data || typeof data !== 'object') return;
    if (data.type !== OFFICIAL_EVENT) return;

    if (isValidResult(data.result)) {
      release(data.result);
    }
  });

  window.MAXESS_E00_03 = {
    version: VERSION,
    contractVersion: CONTRACT,
    isReleased: function () {
      return released;
    },
    getResult: function () {
      return officialResult;
    },
    check: function () {
      recover();
      return released;
    },
    release: function () {
      const result = getCanonicalResult();
      return result ? release(result) : false;
    },
    reset: function () {
      released = false;
      officialResult = null;
      recoveryAttempts = 0;
      clearRecovery();
      try { delete window.MAXESS_RESULTS_RELEASED; } catch (error) { window.MAXESS_RESULTS_RELEASED = false; }
      try { delete window.MAXESS_RESULTS_CONTROLLER; } catch (error) { window.MAXESS_RESULTS_CONTROLLER = null; }
    }
  };

  function initialize() {
    setTimeout(recover, 0);
    setTimeout(function () {
      if (!released) recover();
    }, 100);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initialize, { once: true });
  } else {
    initialize();
  }

  console.log('[E00.03] MAXESS Results Release Authority V2 initialized.');
})();
</script>
