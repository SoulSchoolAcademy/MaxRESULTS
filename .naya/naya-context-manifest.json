{
  "schema": "naya-context-manifest/v1",
  "status": "CANONICAL",
  "effective": "2026-08-23",
  "repository": "SoulSchoolAcademy/MaxRESULTS",
  "governance_branch": "main",
  "principle": "FULL SYSTEM AWARENESS + SELECTIVE DEEP LOADING",
  "optimization": "MAXIMUM USEFUL PERFORMANCE: efficiency, effectiveness, correctness, continuity, quality, verification, and reduced unnecessary human effort",
  "boot_order": [
    "START-HERE.md",
    ".naya/NAYA-LAW-SYSTEM-PROTOCOL.md",
    "docs/REPOSITORY-MAP.md",
    "NAYA-OS.md",
    "docs/NAYA-LAW-MASTER-ACTIVATION-SPECIFICATION.md",
    "docs/NAYA-BRAIN-MASTER-ACTIVATION-SPECIFICATION.md",
    "docs/NAYA-NOTES-MASTER-ACTIVATION-SPECIFICATION.md",
    ".naya/memory/restore-context.json",
    ".naya/memory/memory-index.yaml",
    ".naya/memory/taxonomy.yaml",
    ".naya/memory/note-schema.yaml",
    "docs/smart-notes/INDEX.md",
    "docs/NAYA-PERSONALITY-MANUSCRIPT-ACTIVATION-PROTOCOL.md",
    "docs/NAYA-NITRO-MASTER-ACTIVATION-SPECIFICATION.md",
    "docs/NAYA-LANGUAGE-DICTIONARY.md",
    "docs/NAYA-SCORECARDING-SYSTEM.md",
    "docs/NAYA-GOVERNANCE-REGISTRY.md"
  ],
  "subjects": {
    "law": {"canonical": "docs/NAYA-LAW-MASTER-ACTIVATION-SPECIFICATION.md", "execution_integrity": ".naya/NAYA-LAW-SYSTEM-PROTOCOL.md"},
    "brain": {"canonical": "docs/NAYA-BRAIN-MASTER-ACTIVATION-SPECIFICATION.md"},
    "notes": {"canonical": "docs/NAYA-NOTES-MASTER-ACTIVATION-SPECIFICATION.md", "runtime": ".naya/memory"},
    "memory_runtime": {"canonical": ".naya/memory/restore-context.json", "index": ".naya/memory/memory-index.yaml", "schema": ".naya/memory/note-schema.yaml", "taxonomy": ".naya/memory/taxonomy.yaml", "validator": ".naya/scripts/validate_naya_memory.py"},
    "personality": {"canonical": "docs/NAYA-PERSONALITY-MANUSCRIPT-ACTIVATION-PROTOCOL.md"},
    "nitro": {"canonical": "docs/NAYA-NITRO-MASTER-ACTIVATION-SPECIFICATION.md"},
    "language": {"canonical": "docs/NAYA-LANGUAGE-DICTIONARY.md"},
    "scorecard": {"canonical": "docs/NAYA-SCORECARDING-SYSTEM.md"},
    "governance": {"canonical": "docs/NAYA-GOVERNANCE-REGISTRY.md"},
    "product": {"canonical": "docs/MAXESS-RESULTS-PRODUCT-SPEC.md"},
    "deployment": {"canonical": "docs/DEPLOYMENT-CONTRACT.md"},
    "release": {"canonical": "docs/RELEASE-CHECKLIST.md"}
  },
  "task_routes": {
    "strategy": ["law", "brain", "language"],
    "memory": ["law", "brain", "notes", "memory_runtime"],
    "restore_context": ["law", "brain", "notes", "memory_runtime"],
    "execution": ["law", "brain", "nitro", "scorecard"],
    "design": ["law", "brain", "personality", "scorecard"],
    "engineering": ["law", "brain", "nitro", "scorecard"],
    "results": ["law", "brain", "nitro", "scorecard", "product", "deployment", "release"],
    "evaluation": ["law", "scorecard", "brain"]
  },
  "context_states": [
    "DOCUMENTED",
    "ACTIVATED",
    "CONTEXT ESTABLISHED",
    "IMPLEMENTED",
    "VERIFIED",
    "LIVE VERIFIED",
    "HUMAN REVIEW REQUIRED",
    "BLOCKED",
    "UNKNOWN"
  ],
  "authority_rules": {
    "current_verified_reality_overrides": ["history", "memory", "inference", "assumption"],
    "current_human_requirements_override": ["supporting_docs", "history", "convenience"],
    "canonical_subject_owner_overrides": ["supporting_docs", "historical_docs"],
    "stale_docs_are": "historical_evidence_unless_explicitly_repromoted_by_governance"
  },
  "memory_runtime": {
    "command": "Naya Power — RESTORE CONTEXT",
    "note_command": "Naya Power — MAKE THIS A SMART NOTE",
    "quality_gate": ".github/workflows/naya-memory-runtime.yml",
    "rule": "When conversational context fades, Naya does not guess. Naya restores."
  }
}
