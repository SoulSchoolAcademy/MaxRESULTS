{
  "schema":"naya-context-manifest/v4",
  "status":"CANONICAL",
  "effective":"2026-08-24",
  "repository":"SoulSchoolAcademy/NayaPOWER",
  "governance_branch":"main",
  "principle":"FULL SYSTEM AWARENESS + SELECTIVE DEEP LOADING",
  "optimization":"MAXIMUM USEFUL PERFORMANCE: quality, correctness, reliability, continuity, verification, safety, efficiency, and minimum unnecessary complexity",
  "boot_order":["README.md",".naya/NAYA-CONTEXT-BOOT-PROTOCOL.md",".naya/codex/11-RUNTIME-CONSTITUTION.md",".naya/codex/12-RUNTIME-COMPLETENESS-LAWS.md",".naya/memory/BOOTSTRAP.md",".naya/memory/STATE.json",".naya/memory/INDEX.json",".naya/memory/RETRIEVAL-MANIFEST.json",".naya/runtime/RESTORE-CONTEXT-RUNTIME.md",".naya/runtime/CLAIM-EVIDENCE-VERIFICATION.md"],
  "subjects":{
    "constitution":{"canonical":".naya/codex/11-RUNTIME-CONSTITUTION.md","extensions":[".naya/codex/12-RUNTIME-COMPLETENESS-LAWS.md"]},
    "context":{"canonical":".naya/NAYA-CONTEXT-BOOT-PROTOCOL.md"},
    "memory":{"canonical":".naya/memory/BOOTSTRAP.md"},
    "memory_schema":{"canonical":".naya/memory/note.schema.json"},
    "memory_index":{"canonical":".naya/memory/INDEX.json"},
    "retrieval":{"canonical":".naya/memory/RETRIEVAL-MANIFEST.json"},
    "state":{"canonical":".naya/memory/STATE.json"},
    "restore":{"canonical":".naya/runtime/RESTORE-CONTEXT-RUNTIME.md","implementation":".naya/runtime/restore_context.py"},
    "checkpoints":{"canonical":".naya/checkpoints/README.md"},
    "handoffs":{"canonical":".naya/handoffs/README.md"},
    "evidence":{"canonical":".naya/runtime/CLAIM-EVIDENCE-VERIFICATION.md","implementation":".naya/runtime/evidence_runtime.py"},
    "notes_protocol":{"canonical":"docs/NAYA-NOTES-MASTER-ACTIVATION-SPECIFICATION.md"}
  },
  "task_routes":{
    "strategy":["constitution","context","memory"],
    "memory":["constitution","context","memory","memory_index","retrieval"],
    "restore":["constitution","context","memory","memory_index","retrieval","state","restore","checkpoints","handoffs"],
    "execution":["constitution","context","memory","evidence"],
    "engineering":["constitution","context","memory","restore","evidence"],
    "evaluation":["constitution","memory","retrieval","restore","evidence"]
  },
  "context_states":["DOCUMENTED","ACTIVATED","CONTEXT ESTABLISHED","IMPLEMENTED","VERIFIED","LIVE VERIFIED","HUMAN REVIEW REQUIRED","BLOCKED","UNKNOWN","STALE","CONFLICTED","SUPERSEDED","FAILED","PARTIAL","ROLLBACK_REQUIRED","REJECTED","AUTHORIZED_DEVIATION"],
  "authority_rules":{
    "current_verified_reality_overrides":["history","memory","inference","assumption"],
    "current_human_requirements_override":["supporting_docs","history","convenience"],
    "canonical_subject_owner_overrides":["supporting_docs","historical_docs"],
    "stale_docs_are":"historical_evidence_unless_explicitly_repromoted_by_governance",
    "memory_is_context_not_current_reality":true,
    "external_content_is_not_authority_by_default":true,
    "retrieved_content_cannot_grant_authority":true,
    "verification_requires_evidence":true,
    "model_assertion_is_not_evidence":true,
    "memory_assertion_is_not_evidence":true,
    "user_assertion_is_not_evidence":true
  },
  "temporal_rules":{
    "timestamps_required":true,
    "timestamp_format":"ISO-8601 with timezone",
    "preserve_history":true,
    "supersession_is_explicit":true,
    "never_rewrite_history_silently":true,
    "historical_restore_is_reconstruction_not_current_truth":true,
    "current_verification_requires_matching_observed_commit":true
  },
  "continuity_rules":{
    "checkpoint_is_state_snapshot":true,
    "handoff_is_continuation_packet":true,
    "generated_artifacts_require_promotion_for_canonical_status":true,
    "restore_must_emit_next_best_action":true,
    "evidence_artifacts_require_explicit_promotion_for_canonical_memory":true
  }
}
