{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "naya-power-smart-note/v1",
  "title": "Naya Power Smart Note",
  "type": "object",
  "additionalProperties": false,
  "required": ["id","type","title","status","created_at","effective_at","source","summary","what_happened","what_we_learned","why_it_matters","what_changed","next_best_action","tags","aliases","relationships"],
  "properties": {
    "id": {"type":"string","pattern":"^SN-[0-9]{8}-[0-9]{6}-[a-z0-9-]+$"},
    "type": {"enum":["decision","lesson","discovery","correction","architecture","preference","milestone","handoff","failure","fact","strategy"]},
    "title": {"type":"string","minLength":5},
    "status": {"enum":["ACTIVE","CANONICAL","HISTORICAL","SUPERSEDED","CONFLICTED","STALE"]},
    "created_at": {"type":"string","format":"date-time"},
    "effective_at": {"type":"string","format":"date-time"},
    "superseded_at": {"type":["string","null"],"format":"date-time"},
    "source": {"type":"object","additionalProperties":false,"required":["kind","path"],"properties":{"kind":{"type":"string"},"path":{"type":"string"},"commit":{"type":["string","null"]},"conversation_ref":{"type":["string","null"]}}},
    "summary": {"type":"string","minLength":20},
    "what_happened": {"type":"string"},
    "what_we_learned": {"type":"array","items":{"type":"string"}},
    "why_it_matters": {"type":"string"},
    "what_changed": {"type":"array","items":{"type":"string"}},
    "next_best_action": {"type":"string"},
    "content": {"type":"string"},
    "tags": {"type":"array","items":{"type":"string"},"uniqueItems":true},
    "aliases": {"type":"array","items":{"type":"string"},"uniqueItems":true},
    "relationships": {"type":"object","additionalProperties":false,"properties":{"related":{"type":"array","items":{"type":"string"}},"supersedes":{"type":["string","null"]},"superseded_by":{"type":["string","null"]},"depends_on":{"type":"array","items":{"type":"string"}}}},
    "confidence": {"enum":["HIGH","MEDIUM","LOW","UNKNOWN"]},
    "evidence": {"type":"array","items":{"type":"string"}},
    "valid_time": {"type":"object","additionalProperties":false,"properties":{"from":{"type":"string","format":"date-time"},"to":{"type":["string","null"],"format":"date-time"}}}
  }
}
