{
  "schema_version": 4,
  "policy_name": "Naya Power Execution Continuity Enforcement",
  "effective_at": "2026-08-25T20:31:00-07:00",
  "structured_handoff_effective_at": "2026-08-29T06:10:00-07:00",
  "meaningful_event_types": [
    "execution-milestone",
    "master-system-update",
    "implementation",
    "implementation-milestone",
    "deployment",
    "release",
    "repair",
    "verification",
    "system-change"
  ],
  "meaningful_tags": [
    "execution",
    "implemented",
    "deployment",
    "release",
    "repair",
    "verification",
    "hardening"
  ],
  "event_id_markers": [
    "-execution",
    "-implementation",
    "-deployment",
    "-release",
    "-repair"
  ],
  "handoff_roots": [
    ".naya/handoffs"
  ],
  "successor_torch_contract": ".naya/contracts/NEXT-ACTION-DELIVERY-CONTRACT-v1.json",
  "successor_torch_template": ".naya/templates/NEXT-NAYA-SUCCESSOR-TORCH.md",
  "structured_handoff_fields": [
    "mission",
    "source_of_truth",
    "current_state",
    "protected_baseline",
    "work_completed",
    "evidence",
    "decisions",
    "lessons",
    "unknowns",
    "risks",
    "recommendation",
    "next_action",
    "ready_to_run_execution",
    "human_continuation",
    "human_continuation_naya_authored"
  ],
  "next_action_delivery_schema": {
    "version": 1,
    "canonical_contract_path": ".naya/contracts/NEXT-ACTION-DELIVERY-CONTRACT-v1.json",
    "required_fields": [
      "next_action",
      "next_actor",
      "ready_to_run_execution",
      "expected_output",
      "success_criteria",
      "verification"
    ],
    "conditional_fields": [
      "human_prompt_authoring_required"
    ],
    "human_continuation_actors": [
      "human",
      "shawn",
      "user"
    ],
    "successor_context_fields": [
      "mission",
      "current_state",
      "constraints",
      "why_this_action"
    ],
    "human_continuation_required_fields": [
      "human_action",
      "human_return_payload"
    ],
    "principle": "A substantive execution may not complete without an executable operational torch containing the next action, next actor, ready-to-run execution, expected output, success criteria, verification, and enough successor context to act without reconstructing the conversation."
  },
  "contract": {
    "paired_representations": true,
    "verification": true,
    "durable_receipt": true,
    "delivery_state": true,
    "ai_to_ai_handoff": true,
    "structured_handoff": true,
    "learning_or_explicit_status": true,
    "next_action": true,
    "naya_owned_human_continuation": true,
    "human_prompt_authoring_required": "conditional",
    "response_delivery_contract": true
  },
  "design_principle": "Enforce meaningful executions through one canonical successor-torch schema, one reusable handoff template, and the existing continuity/project validators; preserve the existing green boundary and do not create a parallel continuity engine."
}
