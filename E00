<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#050509">
<meta name="color-scheme" content="dark">
<title>MAXESS — AI Mastery Assessment</title>

<style>
/*
===========================================================
MAXESS E00 — ISOLATED AI MASTERY ASSESSMENT
VERSION: MAXESS_E00_ISOLATED_V4
===========================================================

IMPORTANT ARCHITECTURE RULE:

Everything is scoped under #maxess-ai-score.

This prevents E00 from changing the styling of:
E01, E02, E03, E04, E05, E06, E07, E08, E09
or the Results host page.

E00 owns ONLY its own visual surface and result production.
E00 does NOT control Results-page sequencing.
===========================================================
*/

#maxess-ai-score,
#maxess-ai-score *{
  box-sizing:border-box;
}

#maxess-ai-score{
  --bg:#050509;
  --panel:#0b0b12;
  --panel2:#10101a;
  --text:#faf9ff;
  --muted:#b8b4c3;
  --muted2:#777383;
  --purple:#9568ff;
  --purple2:#c3a8ff;
  --purple3:#4e269f;
  --line:rgba(255,255,255,.12);
  --line2:rgba(255,255,255,.2);
  --shadow:0 28px 80px rgba(0,0,0,.65);
  --ease:cubic-bezier(.2,.8,.2,1);

  width:100%;
  max-width:none;
  min-width:0;
  margin:0;
  padding:0;
  display:block;
  position:relative;
  isolation:isolate;

  background:#050509;
  color:var(--text);

  font-family:
    Inter,
    ui-sans-serif,
    system-ui,
    -apple-system,
    BlinkMacSystemFont,
    "Segoe UI",
    sans-serif;

  overflow:visible;
}

#maxess-ai-score button{
  font:inherit;
}

#maxess-ai-score button:focus-visible{
  outline:2px solid #fff;
  outline-offset:4px;
}

#maxess-ai-score button:disabled{
  cursor:not-allowed;
}

#maxess-ai-score ::selection{
  background:rgba(149,104,255,.32);
  color:#fff;
}

/* ========================================================
   APPLICATION
======================================================== */

#maxess-ai-score .maxess-app{
  width:100%;
  min-width:0;
  min-height:100svh;
  min-height:100dvh;
  position:relative;

  background:
    radial-gradient(
      circle at 50% -8%,
      rgba(126,76,255,.18),
      transparent 34%
    ),
    radial-gradient(
      circle at 100% 60%,
      rgba(88,42,180,.08),
      transparent 34%
    ),
    #050509;
}

#maxess-ai-score .maxess-app::before{
  content:"";
  position:absolute;
  inset:0;
  pointer-events:none;

  background:
    linear-gradient(
      180deg,
      rgba(255,255,255,.025),
      transparent 20%
    );

  opacity:.8;
}

#maxess-ai-score .maxess-shell{
  position:relative;
  z-index:1;

  width:100%;
  max-width:none;
  min-width:0;

  min-height:100svh;

  display:flex;
  flex-direction:column;

  padding:
    max(12px,env(safe-area-inset-top))
    max(12px,env(safe-area-inset-right))
    max(18px,env(safe-area-inset-bottom))
    max(12px,env(safe-area-inset-left));
}

/* ========================================================
   TOP BAR
======================================================== */

#maxess-ai-score .maxess-top{
  width:min(1180px,100%);
  min-width:0;

  margin:0 auto 12px;

  display:grid;
  grid-template-columns:auto minmax(0,1fr) auto;
  align-items:center;

  gap:18px;
}

#maxess-ai-score .maxess-brand{
  min-width:0;

  font-size:clamp(19px,2vw,25px);
  font-weight:950;
  letter-spacing:.15em;
  white-space:nowrap;
}

#maxess-ai-score .maxess-brand span{
  color:#b895ff;
}

#maxess-ai-score .maxess-progress{
  justify-self:center;

  width:min(440px,100%);
  min-width:0;

  display:flex;
  align-items:center;

  gap:10px;
  padding:8px 12px;

  border:1px solid var(--line);
  border-radius:999px;

  background:
    linear-gradient(
      180deg,
      rgba(255,255,255,.075),
      rgba(255,255,255,.025)
    );

  box-shadow:
    inset 0 1px 0 rgba(255,255,255,.08),
    0 12px 35px rgba(0,0,0,.4),
    0 0 35px rgba(125,74,255,.08);

  backdrop-filter:blur(16px);
}

#maxess-ai-score .maxess-progress-label{
  white-space:nowrap;

  font-size:9px;
  font-weight:950;
  letter-spacing:.12em;
}

#maxess-ai-score .maxess-progress-track{
  height:6px;
  flex:1;
  min-width:70px;

  background:rgba(255,255,255,.07);
  border-radius:99px;
  overflow:hidden;

  box-shadow:inset 0 1px 2px #000;
}

#maxess-ai-score .maxess-progress-fill{
  display:block;

  width:0;
  height:100%;

  border-radius:99px;

  background:
    linear-gradient(
      90deg,
      #6636d9,
      #9568ff,
      #c3a8ff
    );

  box-shadow:0 0 16px rgba(149,104,255,.65);

  transition:width .45s var(--ease);
}

#maxess-ai-score .maxess-progress-percent{
  min-width:32px;

  text-align:right;

  color:var(--muted);

  font-size:9px;
  font-weight:900;
}

/* ========================================================
   BOARD
======================================================== */

#maxess-ai-score .maxess-board{
  width:min(1180px,100%);
  min-width:0;

  margin:auto;

  flex:1;

  position:relative;

  display:flex;
  flex-direction:column;

  border:1px solid rgba(149,104,255,.48);
  border-radius:30px;

  overflow:hidden;

  background:
    radial-gradient(
      circle at 50% 0,
      rgba(149,104,255,.075),
      transparent 38%
    ),
    linear-gradient(
      180deg,
      #08080d,
      #050508
    );

  box-shadow:
    0 0 0 1px rgba(255,255,255,.02),
    var(--shadow),
    0 0 75px rgba(83,40,180,.09),
    inset 0 1px 0 rgba(255,255,255,.1);
}

#maxess-ai-score .maxess-board::after{
  content:"";

  position:absolute;

  left:12%;
  right:12%;
  top:0;

  height:1px;

  background:
    linear-gradient(
      90deg,
      transparent,
      rgba(195,168,255,.7),
      transparent
    );

  box-shadow:0 0 20px rgba(149,104,255,.4);
}

#maxess-ai-score .maxess-content{
  position:relative;
  z-index:1;

  width:100%;
  min-width:0;

  padding:clamp(22px,3vw,36px);

  display:flex;
  flex:1;
  flex-direction:column;
}

/* ========================================================
   COMMAND BAR
======================================================== */

#maxess-ai-score .maxess-command{
  display:flex;
  align-items:center;
  justify-content:space-between;

  gap:14px;

  margin-bottom:clamp(18px,2.5vw,30px);
}

#maxess-ai-score .maxess-naya-btn,
#maxess-ai-score .maxess-continue{
  position:relative;

  min-height:55px;

  border-radius:18px;

  border:1px solid rgba(181,140,255,.72);

  color:#fff;

  cursor:pointer;

  background:
    linear-gradient(
      180deg,
      #17151d,
      #08080c
    );

  box-shadow:
    inset 0 1px 0 rgba(255,255,255,.1),
    0 12px 30px rgba(0,0,0,.58),
    0 0 30px rgba(149,104,255,.12);

  transition:
    transform .22s var(--ease),
    box-shadow .22s ease,
    border-color .22s ease;
}

#maxess-ai-score .maxess-naya-btn{
  display:flex;
  align-items:center;

  gap:10px;

  padding:6px 15px 6px 7px;
}

#maxess-ai-score .maxess-naya-btn:hover,
#maxess-ai-score .maxess-continue:hover:not(:disabled){
  transform:translateY(-2px);

  border-color:#c9b1ff;

  box-shadow:
    inset 0 1px 0 rgba(255,255,255,.14),
    0 16px 38px rgba(0,0,0,.65),
    0 0 42px rgba(149,104,255,.28);
}

#maxess-ai-score .maxess-naya-orb{
  width:40px;
  height:40px;
  flex:0 0 40px;

  border-radius:50%;

  display:grid;
  place-items:center;

  background:
    radial-gradient(
      circle at 30% 20%,
      #fff,
      #d7c8ff 16%,
      #9568ff 42%,
      #3c197f 72%,
      #09050f
    );

  border:1px solid #e5dcff;

  box-shadow:
    inset 0 2px 4px rgba(255,255,255,.75),
    0 0 22px rgba(149,104,255,.38),
    0 7px 15px rgba(0,0,0,.62);
}

#maxess-ai-score .maxess-naya-orb::after{
  content:"";

  width:0;
  height:0;

  margin-left:3px;

  border-top:7px solid transparent;
  border-bottom:7px solid transparent;
  border-left:11px solid #fff;

  filter:drop-shadow(0 2px 3px #000);
}

#maxess-ai-score .maxess-naya-btn.playing .maxess-naya-orb{
  animation:maxess-breathe 1.35s ease-in-out infinite;
}

#maxess-ai-score .maxess-naya-btn.playing .maxess-naya-orb::after{
  width:10px;
  height:13px;

  margin:0;

  border:0;

  background:
    linear-gradient(
      90deg,
      #fff 0 35%,
      transparent 35% 65%,
      #fff 65%
    );
}

#maxess-ai-score .maxess-naya-copy{
  display:flex;
  flex-direction:column;

  text-align:left;
  line-height:1.05;
}

#maxess-ai-score .maxess-naya-copy strong{
  font-size:14px;
  font-weight:950;
}

#maxess-ai-score .maxess-naya-copy span{
  margin-top:5px;

  color:#c9c4d4;

  font-size:10px;
  font-weight:700;
}

#maxess-ai-score .maxess-continue{
  min-width:190px;

  padding:0 22px;

  font-size:14px;
  font-weight:950;
}

#maxess-ai-score .maxess-continue::before{
  content:"";

  position:absolute;

  left:10%;
  right:10%;
  top:5px;

  height:1px;

  background:rgba(255,255,255,.42);
}

#maxess-ai-score .maxess-continue:disabled{
  opacity:.72;

  color:rgba(255,255,255,.42);

  border-color:rgba(255,255,255,.1);

  box-shadow:
    inset 0 1px 0 rgba(255,255,255,.04),
    0 8px 20px rgba(0,0,0,.3);
}

#maxess-ai-score .maxess-arrow{
  display:inline-block;

  margin-left:8px;

  font-size:17px;

  transition:transform .22s var(--ease);
}

#maxess-ai-score .maxess-continue:hover:not(:disabled) .maxess-arrow{
  transform:translateX(3px);
}

/* ========================================================
   QUESTION
======================================================== */

#maxess-ai-score .maxess-question{
  width:min(960px,100%);
  min-width:0;

  margin:0 auto;

  text-align:center;
}

#maxess-ai-score .maxess-eyebrow{
  display:inline-flex;
  align-items:center;

  gap:8px;

  margin-bottom:12px;

  color:#c3a8ff;

  font-size:11px;
  font-weight:950;
  letter-spacing:.17em;

  text-transform:uppercase;
}

#maxess-ai-score .maxess-eyebrow::before,
#maxess-ai-score .maxess-eyebrow::after{
  content:"";

  width:24px;
  height:1px;

  background:
    linear-gradient(
      90deg,
      transparent,
      #a47aff
    );
}

#maxess-ai-score .maxess-eyebrow::after{
  transform:rotate(180deg);
}

#maxess-ai-score .maxess-question-title{
  margin:0;

  font-size:clamp(27px,4vw,49px);

  line-height:1.08;

  letter-spacing:-.035em;

  font-weight:900;

  text-wrap:balance;

  text-shadow:0 2px 16px rgba(0,0,0,.45);
}

#maxess-ai-score .maxess-rule{
  width:180px;
  max-width:35%;

  height:1px;

  margin:18px auto 0;

  background:
    linear-gradient(
      90deg,
      transparent,
      #9568ff,
      transparent
    );

  box-shadow:0 0 16px rgba(149,104,255,.35);
}

/* ========================================================
   ANSWERS
======================================================== */

#maxess-ai-score .maxess-answers{
  width:min(880px,100%);
  min-width:0;

  margin:clamp(18px,2.5vw,28px) auto 0;

  display:grid;

  gap:9px;

  align-content:start;
}

#maxess-ai-score .maxess-answer{
  --accent:#9568ff;

  position:relative;

  width:100%;
  min-width:0;

  min-height:68px;

  display:grid;

  grid-template-columns:
    54px
    minmax(0,1fr)
    32px;

  align-items:center;

  gap:13px;

  padding:7px;

  border:1px solid rgba(255,255,255,.105);
  border-radius:20px;

  color:#fff;

  text-align:left;

  cursor:pointer;

  background:
    linear-gradient(
      180deg,
      #121219,
      #08080c
    );

  box-shadow:
    0 8px 20px rgba(0,0,0,.35),
    inset 0 1px 0 rgba(255,255,255,.055);

  transition:
    transform .22s var(--ease),
    border-color .22s ease,
    box-shadow .22s ease;
}

#maxess-ai-score .maxess-answer:hover,
#maxess-ai-score .maxess-answer.selected{
  transform:translateY(-2px);

  border-color:rgba(195,168,255,.72);

  box-shadow:
    0 15px 34px rgba(0,0,0,.5),
    0 0 30px rgba(149,104,255,.15),
    inset 0 1px 0 rgba(255,255,255,.1);
}

#maxess-ai-score .maxess-answer.selected{
  border-color:var(--purple2);

  background:
    linear-gradient(
      180deg,
      #191721,
      #09090e
    );
}

#maxess-ai-score .maxess-jewel{
  width:52px;
  height:52px;

  display:grid;
  place-items:center;

  border-radius:17px;

  background:
    radial-gradient(
      circle at 28% 20%,
      #fff,
      #d9cbff 12%,
      var(--accent) 42%,
      #120a25 100%
    );

  border:1px solid rgba(255,255,255,.72);

  box-shadow:
    inset 0 2px 4px rgba(255,255,255,.72),
    inset 0 -7px 11px rgba(0,0,0,.45),
    0 5px 13px rgba(0,0,0,.55),
    0 0 20px rgba(149,104,255,.18);
}

#maxess-ai-score .maxess-glyph{
  font-size:21px;
  font-weight:950;

  text-shadow:0 2px 5px #000;
}

#maxess-ai-score .maxess-answer-copy{
  min-width:0;
}

#maxess-ai-score .maxess-answer-title{
  display:block;

  font-size:clamp(14px,1.55vw,17px);

  line-height:1.18;

  font-weight:900;
}

#maxess-ai-score .maxess-answer-sub{
  display:block;

  margin-top:7px;

  color:#ddd9e5;

  font-size:clamp(13px,1.4vw,15px);

  line-height:1.3;

  font-weight:600;
}

#maxess-ai-score .maxess-chevron{
  width:30px;
  height:30px;

  display:grid;
  place-items:center;

  border:1px solid rgba(255,255,255,.11);

  border-radius:50%;

  color:#77727f;

  font-size:18px;
}

#maxess-ai-score .maxess-answer:hover .maxess-chevron,
#maxess-ai-score .maxess-answer.selected .maxess-chevron{
  color:#fff;
  border-color:#a981ff;
}

/* ========================================================
   FOOTER
======================================================== */

#maxess-ai-score .maxess-footer{
  margin-top:12px;

  text-align:center;

  color:#57535f;

  font-size:8px;
  font-weight:800;
  letter-spacing:.14em;

  text-transform:uppercase;
}

/* ========================================================
   DIALOG
======================================================== */

#maxess-ai-score .maxess-dialog{
  position:fixed;

  inset:0;

  z-index:2147483000;

  display:none;

  place-items:center;

  padding:22px;

  background:rgba(0,0,0,.78);

  backdrop-filter:blur(18px);
}

#maxess-ai-score .maxess-dialog.open{
  display:grid;

  animation:maxess-fade .25s ease both;
}

#maxess-ai-score .maxess-dialog-card{
  width:min(690px,100%);

  padding:34px 38px 30px;

  text-align:center;

  border:1px solid rgba(195,168,255,.38);

  border-radius:
    40px
    52px
    46px
    50px;

  background:
    radial-gradient(
      circle at 50% 0,
      rgba(149,104,255,.13),
      transparent 45%
    ),
    linear-gradient(
      145deg,
      #18141f,
      #08080d
    );

  box-shadow:
    0 35px 100px rgba(0,0,0,.75),
    0 0 65px rgba(115,65,225,.18),
    inset 0 1px 0 rgba(255,255,255,.1);
}

#maxess-ai-score .maxess-naya-presence{
  display:flex;

  align-items:center;
  justify-content:center;

  gap:13px;

  margin-bottom:22px;
}

#maxess-ai-score .maxess-presence-orb{
  width:56px;
  height:56px;

  flex:0 0 56px;

  border-radius:50%;

  background-image:
    url(
      'https://raw.githubusercontent.com/SoulSchoolAcademy/MaxRESULTS/main/Naya%20Profile%206.jpg'
    );

  background-size:cover;
  background-position:center 16%;
  background-repeat:no-repeat;

  border:1px solid #e5dcff;

  box-shadow:
    inset 0 2px 4px rgba(255,255,255,.75),
    0 0 28px rgba(149,104,255,.3);
}

#maxess-ai-score .maxess-presence-copy{
  text-align:left;
}

#maxess-ai-score .maxess-presence-copy strong{
  display:block;

  font-size:18px;

  font-weight:950;
}

#maxess-ai-score .maxess-presence-copy span{
  display:block;

  margin-top:4px;

  color:#c9c4d4;

  font-size:12px;

  font-weight:700;
}

#maxess-ai-score .maxess-dialog-kicker{
  color:#fff;

  font-size:clamp(11px,1.2vw,14px);

  font-weight:950;

  letter-spacing:.18em;

  text-transform:uppercase;
}

#maxess-ai-score .maxess-dialog-title{
  margin:9px 0 0;

  color:#fff;

  font-size:clamp(30px,4.5vw,44px);

  line-height:1.04;

  font-weight:950;

  letter-spacing:-.035em;
}

#maxess-ai-score .maxess-dialog-body{
  max-width:560px;

  margin:16px auto 0;

  color:#ddd9e5;

  font-size:clamp(15px,2vw,18px);

  line-height:1.55;

  font-weight:600;
}

#maxess-ai-score .maxess-dialog-body.welcome-copy p{
  margin:0 0 10px;
}

#maxess-ai-score .maxess-dialog-body.welcome-copy p:last-child{
  margin-bottom:0;
}

#maxess-ai-score .maxess-dialog-actions{
  display:flex;

  justify-content:center;

  gap:11px;

  margin-top:26px;

  flex-wrap:wrap;
}

#maxess-ai-score .maxess-dialog-btn{
  min-height:53px;

  padding:0 24px;

  border-radius:17px;

  border:1px solid rgba(195,168,255,.7);

  background:#09090d;

  color:#fff;

  font-weight:950;

  cursor:pointer;

  box-shadow:
    0 12px 28px rgba(0,0,0,.45),
    0 0 25px rgba(149,104,255,.12);
}

#maxess-ai-score .maxess-dialog-btn:hover{
  border-color:#d8c7ff;

  box-shadow:
    0 15px 35px rgba(0,0,0,.55),
    0 0 34px rgba(149,104,255,.24);
}

#maxess-ai-score .maxess-dialog-btn.secondary{
  border-color:rgba(255,255,255,.14);
  color:#aaa6b3;
}

/* ========================================================
   STATES
======================================================== */

#maxess-ai-score .maxess-complete{
  width:100%;

  min-height:420px;

  display:flex;

  align-items:center;
  justify-content:center;

  text-align:center;

  padding:40px;
}

#maxess-ai-score .maxess-complete-inner{
  width:min(700px,100%);
}

#maxess-ai-score .maxess-complete-kicker{
  color:#c3a8ff;

  font-size:12px;

  font-weight:950;

  letter-spacing:.18em;

  text-transform:uppercase;
}

#maxess-ai-score .maxess-complete-title{
  margin:14px 0 0;

  font-size:clamp(30px,5vw,56px);

  line-height:1.04;

  font-weight:950;

  letter-spacing:-.04em;
}

#maxess-ai-score .maxess-complete-copy{
  margin:18px auto 0;

  max-width:580px;

  color:#c9c4d4;

  font-size:17px;

  line-height:1.6;
}

/* ========================================================
   ANIMATION
======================================================== */

@keyframes maxess-fade{
  from{opacity:0}
  to{opacity:1}
}

@keyframes maxess-breathe{
  0%,100%{
    transform:scale(1);
    filter:brightness(1);
  }

  50%{
    transform:scale(1.045);
    filter:brightness(1.12);
  }
}

/* ========================================================
   MOBILE
======================================================== */

@media(max-width:760px){

  #maxess-ai-score .maxess-shell{
    padding:
      max(7px,env(safe-area-inset-top))
      max(5px,env(safe-area-inset-right))
      max(10px,env(safe-area-inset-bottom))
      max(5px,env(safe-area-inset-left));
  }

  #maxess-ai-score .maxess-top{
    grid-template-columns:auto minmax(0,1fr);

    gap:8px;
  }

  #maxess-ai-score .maxess-brand{
    font-size:16px;
  }

  #maxess-ai-score .maxess-progress{
    justify-self:end;

    padding:7px 9px;

    gap:7px;
  }

  #maxess-ai-score .maxess-progress-label{
    font-size:8px;

    letter-spacing:.08em;
  }

  #maxess-ai-score .maxess-progress-track{
    width:58px;
    min-width:58px;

    height:5px;
  }

  #maxess-ai-score .maxess-progress-percent{
