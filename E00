function validate(){if(Q.length!==15||D.length!==5)throw Error('MAXESS structure invalid');Q.forEach((q,i)=>{if(q[0]!=='q'+String(i+1).padStart(2,'0')||q.length!==9||q.slice(4).length!==5)throw Error('Question structure invalid');if(!S[i+1]||S[i+1].length!==5)throw Error('Score map invalid')});D.forEach(d=>{if(Q.filter(q=>q[1]===d[0]).length!==3)throw Error('Dimension structure invalid')})}
function render(){const q=Q[state.i],n=state.i+1;$('progressLabel').textContent=`QUESTION ${n} OF 15`;$('progressFill').style.width=(n/15*100)+'%';$('progressPercent').textContent=Math.round(n/15*100)+'%';$('questionLabel').textContent=q[2];$('questionTitle').textContent=q[3];$('answers').innerHTML='';q.slice(4).map((a,i)=>({id:String.fromCharCode(97+i),title:a[0],sub:a[1],score:S[n][i],accent:['#ffd45a','#35e39b','#3ca8ff','#765cff','#ed42c4'][i]})).sort(()=>Math.random()-.5).forEach(a=>{const b=document.createElement('button');b.type='button';b.className='answer';b.dataset.id=a.id;b.style.setProperty('--accent',a.accent);b.setAttribute('aria-pressed','false');b.innerHTML=`<span class="jewel"><span class="glyph">${['◆','✦','△','✧','✦'][a.id.charCodeAt(0)-97]}</span></span><span class="answer-copy"><span class="answer-title">${esc(a.title)}</span><span class="answer-sub">${esc(a.sub)}</span></span><span class="chevron">›</span>`;b.onclick=()=>select(a.id,b);$('answers').appendChild(b)});state.selected=null;updateContinue()}
function select(id,b){if(state.finalizing)return;state.selected=id;$('answers').querySelectorAll('.answer').forEach(x=>{const yes=x===b;x.classList.toggle('selected',yes);x.setAttribute('aria-pressed',String(yes))});updateContinue()}
function updateContinue(){const disabled=!state.selected||state.finalizing;$('continueButton').disabled=disabled;$('continueButton').setAttribute('aria-disabled',String(disabled))}
function save(){const q=Q[state.i],idx=state.selected.charCodeAt(0)-97,r={questionId:q[0],questionOrder:state.i+1,dimensionId:q[1],answerId:state.selected,score:S[state.i+1][idx]},old=state.responses.findIndex(x=>x.questionId===q[0]);old>=0?state.responses[old]=r:state.responses.push(r)}
function calculate(){if(state.responses.length!==15)throw Error('Exactly 15 responses required');const dimensions=D.map(d=>{const rs=state.responses.filter(r=>r.dimensionId===d[0]);if(rs.length!==3)throw Error('Invalid dimension response count');const raw=rs.reduce((a,r)=>a+r.score,0);return{id:d[0],name:d[1],score:Math.round(raw/12*100)}}),raw=state.responses.reduce((a,r)=>a+r.score,0);return{overallScore:Math.round(raw/60*100),dimensions}}
function buildResult(){const x=calculate(),sorted=[...x.dimensions].sort((a,b)=>b.score-a.score);return{contractVersion:'MAXESS_RESULT_V1',assessmentId:'ai-mastery',assessmentVersion:'CLEAN-V2',completedAt:new Date().toISOString(),overallScore:x.overallScore,masteryBand:band(x.overallScore),dimensions:x.dimensions.map(d=>({...d,band:band(d.score)})),fiveDimensions:x.dimensions.map(d=>({...d,band:band(d.score)})),dimensionScores:Object.fromEntries(x.dimensions.map(d=>[d.id,d.score])),strongestDimension:{...sorted[0],band:band(sorted[0].score)},opportunityDimension:{...sorted[sorted.length-1],band:band(sorted[sorted.length-1].score)},strongestCapability:sorted[0].name,opportunityCapability:sorted[sorted.length-1].name,responses:state.responses.map(r=>({questionId:r.questionId,dimensionId:r.dimensionId,answerId:r.answerId,score:r.score})),selectedInterests:[],naya:{overallNarrativeId:band(x.overallScore)},audio:{overallReportId:band(x.overallScore),overallReportUrl:null}}}
function valid(c){return!!c&&c.contractVersion==='MAXESS_RESULT_V1'&&Number.isInteger(c.overallScore)&&c.overallScore>=0&&c.overallScore<=100&&Array.isArray(c.dimensions)&&c.dimensions.length===5&&Array.isArray(c.responses)&&c.responses.length===15&&new Set(c.responses.map(r=>r.questionId)).size===15}
function encode(c){const bytes=new TextEncoder().encode(JSON.stringify(c));let s='';bytes.forEach(b=>s+=String.fromCharCode(b));return btoa(s).replace(/\+/g,'-').replace(/\//g,'_').replace(/=+$/,'')}
function broadcast(c){window.MAXESS_RESULT=c;try{sessionStorage.setItem('MAXESS_RESULT_V1',JSON.stringify(c))}catch(e){}try{localStorage.setItem('MAXESS_RESULT_V1',JSON.stringify(c))}catch(e){}['MAXESS_RESULT_READY','maxess:result-updated'].forEach(n=>{try{window.dispatchEvent(new CustomEvent(n,{detail:c}))}catch(e){}try{if(window.parent&&window.parent!==window)window.parent.dispatchEvent(new CustomEvent(n,{detail:c}))}catch(e){}});try{window.parent.MAXESS_RESULT=c;window.parent.postMessage({type:'MAXESS_RESULT_READY',result:c},'*')}catch(e){}}
function lockHost(){try{document.documentElement.style.overflow='hidden';document.body.style.overflow='hidden'}catch(e){}try{if(window.top&&window.top!==window){const d=window.top.document;d.documentElement.style.overflow='hidden';d.body.style.overflow='hidden';d.body.dataset.maxessLocked='true'}}catch(e){}}
function restoreHost(){try{document.documentElement.style.overflow='';document.body.style.overflow=''}catch(e){}try{if(window.top&&window.top!==window){const d=window.top.document;if(d.body.dataset.maxessLocked==='true'){d.documentElement.style.overflow='';d.body.style.overflow='';delete d.body.dataset.maxessLocked}}}catch(e){}}
function renderLocalResults(c){ROOT.dataset.completed='true';ROOT.dataset.resultReady='true';ROOT.dataset.contractVersion='MAXESS_RESULT_V1';const cards=c.dimensions.map(d=>`<div class="dimension-card"><div class="dimension-score">${d.score}</div><div class="dimension-name">${esc(d.name)}</div></div>`).join('');$('assessmentStage').innerHTML=`<div class="results-view"><div class="results-hero"><div class="eyebrow">MAXESS RESULTS</div><div class="results-score">${c.overallScore}</div><div class="results-band">${esc(c.masteryBand)} · AI MASTERY</div></div><div class="dimension-grid">${cards}</div><div class="results-proof"><strong>Your Results are calculated.</strong><br>15 responses validated · 5 dimensions calculated · MAXESS_RESULT_V1 verified. Your strongest capability is <strong>${esc(c.strongestCapability)}</strong>; your greatest opportunity is <strong>${esc(c.opportunityCapability)}</strong>.</div><div class="results-actions"><button class="dialog-btn" id="retryResults" type="button">OPEN RESULTS AGAIN →</button></div></div>`;$('retryResults').onclick=()=>handoff(c,true)}
function handoff(c,allowFallback){const encoded=encode(c);if(!encoded)throw Error('MAXESS_RESULT_V1 encoding failed');const resultsUrl='https://results.nayanet.app/#maxess-result='+encoded;window.MAXESS_RESULT_HANDOFF_URL=resultsUrl;let attempted=false;try{if(window.top&&window.top!==window){attempted=true;window.top.location.assign(resultsUrl)}else{attempted=true;window.location.assign(resultsUrl)}}catch(e){attempted=false}if(!attempted&&allowFallback)renderLocalResults(c);return resultsUrl}
function publish(){if(state.finalizing)return false;state.finalizing=true;updateContinue();$('continueText').textContent='Loading Results…';try{if(state.responses.length!==15)throw Error('Exactly 15 responses required');const c=buildResult();if(!valid(c))throw Error('MAXESS_RESULT_V1 validation failed');window.MAXESS_E00_RESULTS_HANDOFF_V1=true;window.MAXESS_RESULT_V1=c;broadcast(c);const url='https://results.nayanet.app/#maxess-result='+encode(c);window.MAXESS_RESULT_HANDOFF_URL=url;ROOT.dataset.completed='true';ROOT.dataset.resultReady='true';ROOT.dataset.contractVersion='MAXESS_RESULT_V1';
renderLocalResults(c);
try{if(window.top&&window.top!==window){window.top.location.assign(url)}else{window.location.assign(url)}}catch(e){console.warn('External Results handoff blocked; retaining verified local Results state.',e)}
return true}catch(e){console.error('MAXESS E00 handoff failed',e);state.finalizing=false;updateContinue();$('continueText').textContent='Continue';$('assessmentStage').innerHTML='<div class="finalizing"><div class="eyebrow">MAXESS ERROR</div><h1>We could not complete your Results handoff.</h1><p style="max-width:620px;margin:18px auto 0;color:#b8b4c3;line-height:1.6">Your assessment could not produce a verified Results contract. No score has been invented.</p></div>';return false}}
function next(e){if(e){e.preventDefault();e.stopPropagation();if(e.stopImmediatePropagation)e.stopImmediatePropagation()}if(state.finalizing||!state.selected)return;save();if(state.i===14){publish();return}state.i++;render();setTimeout(()=>openNaya(),120)}
function openNaya(){if(state.finalizing)return;const q=Q[state.i];$('dialogKicker').textContent=state.first?'MAXESS AI MASTERY ASSESSMENT':`${q[2]} · QUESTION ${state.i+1}`;$('dialogTitle').textContent=state.first?'Welcome to the MAXESS AI Mastery Assessment':"Here's what we're really looking at.";$('dialogBody').innerHTML=state.first?'<p>I’m going to walk you through this assessment.</p><p>It takes about three minutes.</p><p>Answer honestly based on what you actually do today.</p><p>Ready?</p>':`<p>${esc(q[3])}</p>`;$('playNaya').style.display=state.first?'none':'inline-block';$('closeNaya').textContent=state.first?"LET'S GO →":'Got it — let’s go →';$('nayaDialog').classList.add('open');state.first=false}
function closeNaya(){if(state.finalizing)return;$('nayaDialog').classList.remove('open');$('nayaButton').focus()}
$('continueButton').addEventListener('click',next,true);$('nayaButton').onclick=openNaya;$('closeNaya').onclick=closeNaya;$('playNaya').onclick=()=>{const q=Q[state.i];if('speechSynthesis'in window){speechSynthesis.cancel();const u=new SpeechSynthesisUtterance(q[3]);u.rate=.94;u.pitch=1.02;speechSynthesis.speak(u)}$('nayaDialog').classList.remove('open')};document.addEventListener('keydown',e=>{if(e.key==='Escape'&&$('nayaDialog').classList.contains('open'))closeNaya()});
try{validate();lockHost();render();setTimeout(openNaya,180);window.MAXESS_E00_RESULTS_HANDOFF_V1=true;window.MAXESS_RESULT_BRIDGE_V2=true}catch(e){console.error(e);$('questionLabel').textContent='ASSESSMENT ERROR';$('questionTitle').textContent='MAXESS is temporarily unavailable.'}
window.MAXESS_AISCORE={questions:Q,dimensions:D,scoreValues:S,buildContract:buildResult,validateContract:valid,publish};
</script></div>