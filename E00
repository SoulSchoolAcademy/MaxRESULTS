function setNayaPlaying(v){

  state.nayaPlaying=v;

  $('maxessNayaButton')
    .classList.toggle(
      'playing',
      v
    );

  $('maxessPresenceOrb')
    .classList.toggle(
      'playing',
      v
    );

  $('maxessNayaPrimary')
    .textContent=
      v
        ?'Naya is speaking'
        :'Naya';

  $('maxessNayaSecondary')
    .textContent=
      v
        ?'Listen or answer while she speaks'
        :'Help me understand this';

}

function stopNaya(){

  try{
    window.speechSynthesis?.cancel();
  }catch(e){}

  try{
    window.__MAXESS_NAYA_AUDIO?.pause();
  }catch(e){}

  window.__MAXESS_NAYA_AUDIO=null;

  setNayaPlaying(false);

}

function playNaya(){

  stopNaya();

  const q=current();

  const src=q.nayaAudio||null;

  if(src){

    const audio=
      new Audio(src);

    window.__MAXESS_NAYA_AUDIO=
      audio;

    audio.addEventListener(
      'play',
      ()=>setNayaPlaying(true),
      {once:true}
    );

    audio.addEventListener(
      'ended',
      stopNaya,
      {once:true}
    );

    audio.addEventListener(
      'error',
      stopNaya,
      {once:true}
    );

    audio.play()
      .catch(
        ()=>stopNaya()
      );

    return;
  }

  if(
    'speechSynthesis'
    in window
  ){

    const u=
      new SpeechSynthesisUtterance(
        state.nayaText||q.teaching
      );

    u.rate=.94;
    u.pitch=1.02;
    u.volume=1;

    u.onstart=
      ()=>setNayaPlaying(true);

    u.onend=
      stopNaya;

    u.onerror=
      stopNaya;

    window.__MAXESS_NAYA_UTTERANCE=u;

    window.speechSynthesis
      .speak(u);

  }

}

/* ========================================================
   SAVE RESPONSE
======================================================== */

function saveResponse(){

  const q=current();

  const a=
    answerRecords(q)
      .find(
        x=>x.id===state.selected
      );

  if(!a){

    throw new Error(
      'No valid selected answer.'
    );

  }

  const r={
    questionId:q.id,
    questionOrder:q.order,
    dimensionId:q.dimensionId,
    answerId:a.id,
    score:a.score
  };

  const old=
    state.responses.findIndex(
      x=>x.questionId===q.id
    );

  if(old>=0){

    state.responses[old]=r;

  }else{

    state.responses.push(r);

  }

}

/* ========================================================
   CALCULATE
======================================================== */

function calculate(){

  if(state.responses.length!==15){

    throw new Error(
      'All 15 questions must be answered.'
    );

  }

  const dimensions=
    DIMENSIONS.map(d=>{

      const rs=
        state.responses.filter(
          r=>r.dimensionId===d.id
        );

      if(rs.length!==3){

        throw new Error(
          'Dimension response count invalid: '+
          d.id
        );

      }

      const raw=
        rs.reduce(
          (s,r)=>s+r.score,
          0
        );

      return{
        ...d,
        rawScore:raw,
        score:
          Math.round(
            raw/12*100
          )
      };

    });

  const raw=
    state.responses.reduce(
      (s,r)=>s+r.score,
      0
    );

  const overallScore=
    Math.round(
      raw/60*100
    );

  return{
    overallScore,
    masteryBand:BAND(
      overallScore
    ),
    dimensions
  };

}

/* ========================================================
   STRONGEST / OPPORTUNITY
======================================================== */

function strongestAndOpportunity(
  dimensions
){

  const sorted=
    [...dimensions]
      .sort(
        (a,b)=>b.score-a.score
      );

  return{
    strongest:sorted[0],
    opportunity:
      sorted[sorted.length-1]
  };

}

/* ========================================================
   BUILD OFFICIAL RESULT CONTRACT
======================================================== */

function buildContract(){

  const result=
    calculate();

  const so=
    strongestAndOpportunity(
      result.dimensions
    );

  const dimensions=
    result.dimensions.map(d=>({

      id:d.id,

      name:d.name,

      score:d.score,

      band:BAND(d.score)

    }));

  return{

    contractVersion:
      'MAXESS_RESULT_V1',

    assessmentId:
      'ai-mastery',

    assessmentVersion:
      'CLEAN-V1',

    completedAt:
      new Date().toISOString(),

    overallScore:
      result.overallScore,

    masteryBand:
      result.masteryBand,

    dimensions,

    fiveDimensions:
      dimensions,

    dimensionScores:
      Object.fromEntries(
        result.dimensions.map(
          d=>[d.id,d.score]
        )
      ),

    directionScore:
      result.dimensions.find(
        d=>d.id==='direction'
      ).score,

    communicationScore:
      result.dimensions.find(
        d=>d.id==='communication'
      ).score,

    evaluationScore:
      result.dimensions.find(
        d=>d.id==='evaluation'
      ).score,

    iterationScore:
      result.dimensions.find(
        d=>d.id==='iteration'
      ).score,

    systemsThinkingScore:
      result.dimensions.find(
        d=>d.id==='systemsThinking'
      ).score,

    strongestDimension:{
      id:so.strongest.id,
      name:so.strongest.name,
      score:so.strongest.score,
      band:BAND(
        so.strongest.score
      )
    },

    opportunityDimension:{
      id:so.opportunity.id,
      name:so.opportunity.name,
      score:so.opportunity.score,
      band:BAND(
        so.opportunity.score
      )
    },

    strongestCapability:
      so.strongest.name,

    opportunityCapability:
      so.opportunity.name,

    responses:
      state.responses.map(r=>({

        questionId:
          r.questionId,

        dimensionId:
          r.dimensionId,

        answerId:
          r.answerId,

        score:
          r.score

      })),

    selectedInterests:[],

    naya:{

      overallNarrativeId:
        result.masteryBand,

      overallAudioId:
        NAYA_AUDIO_REPORT_SELECTION[
          result.masteryBand
        ],

      dimensionNarratives:
        result.dimensions.map(d=>({

          dimensionId:d.id,

          band:BAND(d.score),

          narrativeId:
            `${d.id}:${BAND(d.score)}`

        }))

    },

    audio:{

      overallReportId:
        NAYA_AUDIO_REPORT_SELECTION[
          result.masteryBand
        ],

      overallReportUrl:
        NAYA_AUDIO_REPORTS[
          result.masteryBand
        ]||null

    }

  };

}

/* ========================================================
   VALIDATE RESULT CONTRACT
======================================================== */

function validateContract(c){

  if(
    !c ||
    c.contractVersion!==
      'MAXESS_RESULT_V1'
  ){
    return false;
  }

  if(
    !Number.isInteger(
      c.overallScore
    ) ||
    c.overallScore<0 ||
    c.overallScore>100
  ){
    return false;
  }

  if(
    ![
      'foundation',
      'developing',
      'advancing',
      'mastery'
    ].includes(
      c.masteryBand
    )
  ){
    return false;
  }

  if(
    !Array.isArray(c.dimensions) ||
    c.dimensions.length!==5
  ){
    return false;
  }

  const expectedDimensionIds=[
    'direction',
    'communication',
    'evaluation',
    'iteration',
    'systemsThinking'
  ];

  if(
    c.dimensions.some(
      (d,i)=>
        !d ||
        d.id!==expectedDimensionIds[i]
    )
  ){
    return false;
  }

  if(
    !Array.isArray(c.responses) ||
    c.responses.length!==15
  ){
    return false;
  }

  const ids=
    new Set(
      c.responses.map(
        r=>r.questionId
      )
    );

  if(ids.size!==15){
    return false;
  }

  if(
    c.responses.some(r=>{

      const q=
        QUESTIONS.find(
          x=>x.id===r.questionId
        );

      return(
        !q ||
        !DIMENSIONS.some(
          d=>d.id===r.dimensionId
        ) ||
        !Number.isInteger(r.score) ||
        r.score<0 ||
        r.score>4 ||
        !q.answers.some(
          a=>a[0]===r.answerId
        )
      );

    })
  ){
    return false;
  }

  if(
    DIMENSIONS.some(
      d=>
        c.responses.filter(
          r=>r.dimensionId===d.id
        ).length!==3
    )
  ){
    return false;
  }

  return true;

}

/* ========================================================
   ENCODE
======================================================== */

function encode(c){

  const bytes=
    new TextEncoder()
      .encode(
        JSON.stringify(c)
      );

  let binary='';

  for(
    const b of bytes
  ){
    binary+=
      String.fromCharCode(b);
  }

  return btoa(binary)
    .replace(/\+/g,'-')
    .replace(/\//g,'_')
    .replace(/=+$/,'');

}

/* ========================================================
   RESULT STORAGE
======================================================== */

function storeResult(c){

  /*
  PRIMARY IN-MEMORY CONTRACT
  */

  window.MAXESS_RESULT=c;

  window.MAXESS_RESULT_V1=c;

  /*
  SESSION STORAGE
  */

  try{

    sessionStorage.setItem(
      'MAXESS_RESULT_V1',
      JSON.stringify(c)
    );

  }catch(e){

    console.warn(
      'MAXESS sessionStorage unavailable.',
      e
    );

  }

  /*
  LOCAL STORAGE
  */

  try{

    localStorage.setItem(
      'MAXESS_RESULT_V1',
      JSON.stringify(c)
    );

  }catch(e){

    console.warn(
      'MAXESS localStorage unavailable.',
      e
    );

  }

}

/* ========================================================
   BROADCAST RESULT
======================================================== */

function broadcastResult(c){

  storeResult(c);

  /*
  LOCAL EVENTS
  */

  const eventNames=[
    'MAXESS_RESULT_READY',
    'maxess:result-updated'
  ];

  eventNames.forEach(name=>{

    try{

      window.dispatchEvent(
        new CustomEvent(
          name,
          {
            detail:c
          }
        )
      );

    }catch(e){

      console.warn(
        'MAXESS event dispatch failed:',
        name,
        e
      );

    }

  });

  /*
  PARENT WINDOW
  */

  try{

    if(
      window.parent &&
      window.parent!==window
    ){

      try{

        window.parent.MAXESS_RESULT=c;

      }catch(e){}

      eventNames.forEach(name=>{

        try{

          window.parent.dispatchEvent(
            new CustomEvent(
              name,
              {
                detail:c
              }
            )
          );

        }catch(e){}

      });

      try{

        window.parent.postMessage(
          {
            type:
              'MAXESS_RESULT_READY',

            version:
              'MAXESS_RESULT_V1',

            result:c
          },
          '*'
        );

      }catch(e){}

    }

  }catch(e){}

  /*
  TOP WINDOW
  */

  try{

    if(
      window.top &&
      window.top!==window
    ){

      try{

        window.top.MAXESS_RESULT=c;

      }catch(e){}

      try{

        window.top.postMessage(
          {
            type:
              'MAXESS_RESULT_READY',

            version:
              'MAXESS_RESULT_V1',

            result:c
          },
          '*'
        );

      }catch(e){}

    }

  }catch(e){}

  /*
  DOM EVENT ON E00 ROOT

  This gives the isolation/controller layer
  a local hook without touching E01-E09.
  */

  try{

    ROOT.dispatchEvent(
      new CustomEvent(
        'MAXESS_E00_COMPLETE',
        {
          bubbles:false,
          detail:c
        }
      )
    );

  }catch(e){}

}

/* ========================================================
   COMPLETE ASSESSMENT
======================================================== */

function completeAssessment(){

  /*
  IMPORTANT:

  There is NO location.assign() here.

  E00 does not redirect itself.
  */

  const c=
    buildContract();

  if(
    !validateContract(c)
  ){

    console.error(
      'MAXESS_RESULT_V1 validation failed.'
    );

    return false;
  }

  /*
  Publish the result contract.
  */

  broadcastResult(c);

  state.completed=true;

  /*
  Mark E00 as complete.

  The bridge/controller can detect this.
  */

  ROOT.dataset.completed='true';

  ROOT.dataset.resultReady='true';

  ROOT.dataset.contractVersion=
    'MAXESS_RESULT_V1';

  /*
  Keep E00 visually stable.

  Do NOT navigate.
  Do NOT render E01.
  Do NOT inject Results HTML.
  */

  $('maxessAssessmentStage')
    .innerHTML=`

      <div class="maxess-complete">

        <div class="maxess-complete-inner">

          <div class="maxess-complete-kicker">
            ASSESSMENT COMPLETE
          </div>

          <div class="maxess-complete-title">
            Your MAXESS result is ready.
          </div>

          <div class="maxess-complete-copy">
            Your answers have been scored and your
            official MAXESS result has been securely
            prepared for the Results experience.
          </div>

        </div>

      </div>

  `;

  return true;

}

/* ========================================================
   CONTINUE
======================================================== */

function continueAssessment(){

  if(!state.selected){
    return;
  }

  saveResponse();

  stopNaya();

  if(state.index===14){

    try{

      completeAssessment();

    }catch(e){

      console.error(
        'MAXESS result generation failed:',
        e
      );

    }

    return;
  }

  state.index++;

  renderQuestion();

  setTimeout(
    openNaya,
    140
  );

}

