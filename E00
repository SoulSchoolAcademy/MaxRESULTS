  nayaPlaying:false,
  completed:false
};

/* ========================================================
   VALIDATION
======================================================== */

function validateAssessment(){

  if(QUESTIONS.length!==15){
    throw new Error(
      'MAXESS requires exactly 15 questions.'
    );
  }

  if(DIMENSIONS.length!==5){
    throw new Error(
      'MAXESS requires exactly 5 dimensions.'
    );
  }

  const qids=new Set();

  QUESTIONS.forEach(q=>{

    if(qids.has(q.id)){
      throw new Error(
        'Duplicate question ID: '+q.id
      );
    }

    qids.add(q.id);

    if(!DIMENSIONS.some(
      d=>d.id===q.dimensionId
    )){
      throw new Error(
        'Invalid dimension for '+q.id
      );
    }

    if(q.answers.length!==5){
      throw new Error(
        'Each question requires five answers.'
      );
    }

    q.answers.forEach((a,i)=>{

      const score=SCORE_VALUES[q.order][i];

      if(
        !Number.isInteger(score) ||
        score<0 ||
        score>4
      ){
        throw new Error(
          'Invalid authoritative score mapping.'
        );
      }

    });

  });

  const counts=
    Object.fromEntries(
      DIMENSIONS.map(
        d=>[d.id,0]
      )
    );

  QUESTIONS.forEach(q=>{
    counts[q.dimensionId]++;
  });

  DIMENSIONS.forEach(d=>{

    if(counts[d.id]!==3){

      throw new Error(
        d.name+
        ' must contain exactly three questions.'
      );

    }

  });

}

/* ========================================================
   QUESTION HELPERS
======================================================== */

function current(){
  return QUESTIONS[state.index];
}

function answerRecords(q){

  return q.answers.map((a,i)=>({

    id:a[0],

    title:a[1],

    description:a[2],

    glyph:a[3],

    score:SCORE_VALUES[q.order][i],

    accent:[
      '#ffd45a',
      '#35e39b',
      '#3ca8ff',
      '#765cff',
      '#ed42c4'
    ][i]

  }));

}

function shuffledAnswers(q){

  let arr=answerRecords(q).slice();

  let x=
    (
      sessionSeed ^
      (q.order*2654435761)
    )>>>0;

  for(
    let i=arr.length-1;
    i>0;
    i--
  ){

    x=
      Math.imul(
        x^x>>>16,
        2246822507
      )>>>0;

    x=
      Math.imul(
        x^x>>>13,
        3266489909
      )>>>0;

    const j=x%(i+1);

    [
      arr[i],
      arr[j]
    ]=[
      arr[j],
      arr[i]
    ];

  }

  return arr;

}

