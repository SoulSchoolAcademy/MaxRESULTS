/* =========================================================
E02 HEADER
========================================================= */

#maxess-e02-v2 .e02-header {
width:100%;
max-width:1200px;

margin:
0 auto
clamp(50px,6vw,75px);

text-align:center;
}

#maxess-e02-v2 .e02-kicker {
margin:0 0 14px;

color:rgba(255,255,255,.48);

font-size:10px;

font-weight:900;

letter-spacing:.30em;

text-transform:uppercase;
}

#maxess-e02-v2 .e02-title {
margin:0;

color:#fff;

font-size:
clamp(25px,3vw,40px);

line-height:1.05;

font-weight:900;

letter-spacing:-.045em;
}

/* =========================================================
FIVE DIMENSIONS
========================================================= */

#maxess-e02-v2 .e02-grid {

width:100%;

max-width:1280px;

margin:0 auto;

display:grid;

grid-template-columns:
repeat(5,minmax(0,1fr));

align-items:start;

justify-content:center;

gap:
clamp(14px,2.5vw,42px);
}

/* =========================================================
DIMENSION
========================================================= */

#maxess-e02-v2 .e02-dimension {

min-width:0;

display:flex;

flex-direction:column;

align-items:center;

text-align:center;
}

/* =========================================================
ORB
========================================================= */

#maxess-e02-v2 .e02-orb-stage {

width:100%;

max-width:190px;

aspect-ratio:1;

position:relative;

display:grid;

place-items:center;
}

/* atmosphere */

#maxess-e02-v2 .e02-glow {

position:absolute;

inset:3%;

border-radius:50%;

background:
radial-gradient(
circle,
color-mix(
in srgb,
var(--e02-color) 26%,
transparent
),
transparent 68%
);

filter:blur(25px);

opacity:.75;
}

/* outer ring */

#maxess-e02-v2 .e02-ring {

position:absolute;

inset:5%;

border-radius:50%;

border:
1px solid
color-mix(
in srgb,
var(--e02-color) 55%,
rgba(255,255,255,.15)
);

box-shadow:
0 0 35px
color-mix(
in srgb,
var(--e02-color) 20%,
transparent
);
}

/* physical orb */

#maxess-e02-v2 .e02-orb {

width:78%;
height:78%;

position:relative;

display:grid;

place-items:center;

border-radius:50%;

background:

radial-gradient(
  circle at 30% 18%,
  rgba(255,255,255,.28),
  transparent 13%
),

radial-gradient(
  circle at 38% 34%,
  color-mix(
    in srgb,
    var(--e02-color) 25%,
    transparent
  ),
  transparent 42%
),

radial-gradient(
  circle at 50% 50%,
  #17121d 0%,
  #09070d 68%,
  #020107 100%
);

border:
1px solid
rgba(255,255,255,.22);

box-shadow:

inset
10px 10px 30px
rgba(255,255,255,.06),

inset
-25px -30px 55px
rgba(0,0,0,.78),

inset
0 0 55px
color-mix(
  in srgb,
  var(--e02-color) 16%,
  transparent
),

0 25px 55px
rgba(0,0,0,.65),

0 0 45px
color-mix(
  in srgb,
  var(--e02-color) 18%,
  transparent
);

animation:
maxess-e02-v2-breathe
6s
ease-in-out
infinite;
}

/* inner energy */

#maxess-e02-v2 .e02-core {

position:absolute;

width:38%;
height:38%;

border-radius:50%;

background:
radial-gradient(
circle at 35% 30%,
rgba(255,255,255,.32),
color-mix(
in srgb,
var(--e02-color) 28%,
transparent
) 30%,
transparent 72%
);

filter:blur(1px);

animation:
maxess-e02-v2-core
3.5s
ease-in-out
infinite;
}

/* =========================================================
SCORE
========================================================= */

#maxess-e02-v2 .e02-score {

position:relative;

z-index:10;

color:#fff;

font-size:
clamp(34px,4vw,58px);

line-height:1;

font-weight:950;

letter-spacing:-.075em;

text-shadow:

0 2px 0 #000,

0 4px 10px rgba(0,0,0,.95),

0 0 24px
color-mix(
  in srgb,
  var(--e02-color) 65%,
  transparent
);

user-select:none;
}

/* =========================================================
ORBITAL BEAD
========================================================= */

#maxess-e02-v2 .e02-orbit {

position:absolute;

inset:5%;

border-radius:50%;

animation:
maxess-e02-v2-orbit
10s
linear
infinite;
}

#maxess-e02-v2 .e02-bead {

position:absolute;

top:0;
left:50%;

width:8px;
height:8px;

transform:
translate(-50%,-50%);

border-radius:50%;

background:
radial-gradient(
circle at 30% 25%,
#fff 0%,
#fff 18%,
var(--e02-color) 48%,
#111 100%
);

box-shadow:

0 0 7px #fff,

0 0 18px
var(--e02-color);

}

/* =========================================================
NAME
========================================================= */

#maxess-e02-v2 .e02-name {

width:100%;

margin-top:
clamp(18px,2vw,25px);

color:#fff;

font-size:
clamp(9px,1vw,12px);

line-height:1.25;

font-weight:900;

letter-spacing:.14em;

text-transform:uppercase;

text-align:center;
}

/* =========================================================
COLORS
========================================================= */

#maxess-e02-v2
.e02-dimension:nth-child(1) {
--e02-color:var(--e02-purple);
}

#maxess-e02-v2
.e02-dimension:nth-child(2) {
--e02-color:var(--e02-coral);
}

#maxess-e02-v2
.e02-dimension:nth-child(3) {
--e02-color:var(--e02-emerald);
}

#maxess-e02-v2
.e02-dimension:nth-child(4) {
--e02-color:var(--e02-blue);
}

#maxess-e02-v2
.e02-dimension:nth-child(5) {
--e02-color:var(--e02-gold);
}

/* =========================================================
MOTION
========================================================= */

@keyframes maxess-e02-v2-breathe {

0%,
100% {
transform:scale(1);
}

50% {
transform:scale(1.018);
}
}

@keyframes maxess-e02-v2-core {

0%,
100% {
transform:scale(.94);
opacity:.78;
}

50% {
transform:scale(1.06);
opacity:1;
}
}

@keyframes maxess-e02-v2-orbit {

from {
transform:rotate(0deg);
}

to {
transform:rotate(360deg);
}
}

