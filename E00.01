<script id="MAXESS-E00-01-BRIDGE-V8">
(function () {
  'use strict';

  if (window.__MAXESS_E00_01_BRIDGE_V8__) return;
  window.__MAXESS_E00_01_BRIDGE_V8__ = true;

  const BRIDGE = 'MAXESS-E00-01-BRIDGE-V8';
  const CONTRACT = 'MAXESS_RESULT_V1';

  let released = false;
  let terminalTriggered = false;

  function getResult() {
    if (
      window.MAXESS_RESULT &&
      window.MAXESS_RESULT.contractVersion === CONTRACT
    ) {
      return window.MAXESS_RESULT;
    }

    try {
      const stored = sessionStorage.getItem(CONTRACT);
      if (stored) {
        const parsed = JSON.parse(stored);
        if (parsed && parsed.contractVersion === CONTRACT) {
          window.MAXESS_RESULT = parsed;
          return parsed;
        }
      }
    } catch (e) {}

    return null;
  }

  function validResult(result) {
    return !!result &&
      result.contractVersion === CONTRACT &&
      Number.isInteger(result.overallScore) &&
      result.overallScore >= 0 &&
      result.overallScore <= 100 &&
      Array.isArray(result.dimensions) &&
      result.dimensions.length === 5 &&
      result.dimensions.every(function (d) {
        return d && Number.isInteger(d.score) && d.score >= 0 && d.score <= 100;
      }) &&
      Array.isArray(result.responses) &&
      result.responses.length === 15 &&
      new Set(result.responses.map(function (r) { return r.questionId; })).size === 15;
  }

  /*
   * TERMINAL AUTHORITY
   *
   * E00 owns the scoring engine. E00.01 does not calculate a
   * score and does not duplicate scoring logic. It simply makes
   * the existing E00 publish() authority execute immediately
   * when Q15's Continue button is clicked.
   *
   * Q15 Continue
   *   -> E00.publish()
   *   -> save Q15
   *   -> calculate 15-response result
   *   -> validate MAXESS_RESULT_V1
   *   -> persist/broadcast
   *   -> release E01-E09
   */
  function terminalClick(event) {
    const button = event.target &&
      event.target.closest &&
      event.target.closest('#maxess-ai-score #continueButton');

    if (!button || button.disabled) return;

    const label = (button.textContent || '').trim().toLowerCase();
    if (label.indexOf('assessment complete') === -1) return;

    if (terminalTriggered) {
      event.preventDefault();
      event.stopImmediatePropagation();
      return;
    }

    if (!window.MAXESS_AISCORE || typeof window.MAXESS_AISCORE.publish !== 'function') {
      console.error('[MAXESS BRIDGE] E00 scoring authority is unavailable.');
      return;
    }

    event.preventDefault();
    event.stopImmediatePropagation();
    terminalTriggered = true;

    try {
      const ok = window.MAXESS_AISCORE.publish();

      if (!ok) {
        terminalTriggered = false;
        console.error('[MAXESS BRIDGE] E00 terminal publish refused.');
        return;
      }

      const completionDialog = document.getElementById('completionDialog');
      if (completionDialog) completionDialog.classList.remove('open');

      console.log('[MAXESS BRIDGE] Q15 terminal execution complete.');
    } catch (error) {
      terminalTriggered = false;
      console.error('[MAXESS BRIDGE] Q15 terminal execution failed.', error);
    }
  }

  /* Capture phase intentionally matches E00's terminal event boundary. */
  document.addEventListener('click', terminalClick, true);

  function showResults() {
    if (released) return;

    const result = getResult();
    if (!validResult(result)) return;

    released = true;

    window.MAXESS_RESULTS_RELEASED = true;
    window.MAXESS_RESULTS_BRIDGE = BRIDGE;
    window.MAXESS_RESULTS_DATA = result;

    try {
      window.dispatchEvent(new CustomEvent('MAXESS_ISOLATION_RELEASE', {
        detail: {
          result: result,
          contractVersion: CONTRACT,
          bridge: BRIDGE
        }
      }));
    } catch (e) {}

    try {
      window.dispatchEvent(new CustomEvent('MAXESS_RESULTS_READY', {
        detail: result
      }));
    } catch (e) {}

    try {
      document.documentElement.setAttribute(
        'data-maxess-results-state',
        'released'
      );
    } catch (e) {}

    console.log('[MAXESS BRIDGE] RESULTS RELEASED', result.overallScore);
  }

  window.MAXESS_E00_01 = {
    version: 8,
    contractVersion: CONTRACT,
    getResult: getResult,
    release: showResults,
    terminal: function () {
      if (window.MAXESS_AISCORE && typeof window.MAXESS_AISCORE.publish === 'function') {
        return window.MAXESS_AISCORE.publish();
      }
      return false;
    }
  };

  window.addEventListener('MAXESS_RESULTS_RELEASE', showResults);
  window.addEventListener('MAXESS_RESULT_READY', showResults);
  window.addEventListener('maxess:result-updated', showResults);

  /* No initial storage recovery: stale results must never release this page. */
  console.log('[MAXESS BRIDGE] E00.01 V8 initialized; awaiting current assessment completion.');
})();
</script>
