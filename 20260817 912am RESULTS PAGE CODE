<script id="maxess-results-v15-js">
(function(){
'use strict';
const root=document.getElementById('maxess-results-10');
if(!root||root.dataset.v15Reconstructed==='1')return;
root.dataset.v15Reconstructed='1';
const clamp=n=>Math.max(0,Math.min(100,n));
const esc=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const R=()=>window.MAXESS_RESULT||null;
const n=v=>{const x=Number(v);return Number.isFinite(x)?x:null};
const first=(...v)=>v.find(x=>x!==undefined&&x!==null&&String(x).trim()!=='')||'';
function score(){const r=R()||{};const x=n(r.overallScore??r.masterScore??r.score??r.overall);return x===null?null:clamp(x)}
function dims(){const r=R()||{};return (Array.isArray(r.dimensions)?r.dimensions:[]).slice(0,5).map((d,i)=>({id:d.id||String(i+1),name:first(d.name,d.label,`Dimension ${i+1}`),score:clamp(n(d.score??d.value??d.percentage??0)??0),description:first(d.description,d.insight)}))}
function profile(){const r=R()||{};const p=r.profile&&typeof r.profile==='object'?r.profile:{};const u=r.user&&typeof r.user==='object'?r.user:{};const person=r.person&&typeof r.person==='object'?r.person:{};const identity=r.identity&&typeof r.identity==='object'?r.identity:{};return {name:first(p.name,p.displayName,u.name,u.displayName,person.name,identity.name,r.name,r.firstName),role:first(p.role,p.title,p.profession,u.role,person.role,r.role),goal:first(p.goal,p.primaryGoal,p.objective,u.goal,person.goal,r.goal,r.primaryGoal),experience:first(p.experienceLevel,p.level,u.experienceLevel,person.experienceLevel,r.experienceLevel),organization:first(p.organization,p.company,u.organization,person.organization,r.organization),location:first(p.location,u.location,person.location,r.location),bio:first(p.bio,p.about,u.bio,person.bio,r.bio)} }
function band(s){return s>=91?'Mastering':s>=76?'Advancing':s>=51?'Developing':'Foundation'}
function strongest(ds){return ds.slice().sort((a,b)=>b.score-a.score)[0]||null}
function lever(ds){if(!ds.length)return null;const avg=ds.reduce((a,d)=>a+d.score,0)/ds.length;return ds.slice().sort((a,b)=>(avg-b.score)-(avg-a.score))[0]||ds.slice().sort((a,b)=>a.score-b.score)[0]}
const colors=['#ff9d3d','#ffd84a','#39df91','#4c9dff','#965dff'];
function ensureClass(){root.classList.add('v15-results')}
function createProfile(s,ds){const p=profile(),top=strongest(ds),low=lever(ds);const old=document.getElementById('maxess-personal-profile');if(old)old.remove();const sec=document.createElement('section');sec.id='v15-personal-profile';sec.className='mx-section';sec.setAttribute('aria-label','Your MAXESS personal profile');const context=first(p.role,p.goal,p.experience,p.organization,'Assessment profile');sec.innerHTML=`<div class="v15-profile"><div class="v15-profile-head"><div><span class="v15-profile-kicker">YOUR MAXESS PROFILE</span><h2>${p.name?esc(p.name)+', here is your AI profile.':'Here is your AI profile.'}</h2><p class="v15-profile-sub">This is your personal reading of the assessment — built from the result you actually submitted, not a generic template.</p></div><div class="v15-profile-score"><strong>${Math.round(s)}</strong><span>/ 100</span></div></div><div class="v15-profile-grid"><div class="v15-profile-cell"><span>LEVEL</span><b>${band(s)}</b><small>Your current MAXESS mastery range.</small></div><div class="v15-profile-cell"><span>STRONGEST SIGNAL</span><b>${top?esc(top.name):'Building'}</b><small>${top?Math.round(top.score)+' / 100':'Awaiting dimension data'}</small></div><div class="v15-profile-cell"><span>BIGGEST LEVER</span><b>${low?esc(low.name):'Your next opportunity'}</b><small>${low?Math.round(low.score)+' / 100':'Awaiting dimension data'}</small></div><div class="v15-profile-cell"><span>PROFILE CONTEXT</span><b>${esc(context)}</b><small>${p.role||p.goal||p.experience||p.organization?'Context supplied by the authoritative Result Contract.':'Core score and dimension data currently available.'}</small></div></div>${p.goal?`<p class="v15-profile-context"><strong>Your stated goal:</strong> ${esc(p.goal)}. I’ll use that context to frame the next move without changing your assessment score.</p>`:''}<span class="v15-profile-badge"><i aria-hidden="true"></i>${p.name||p.goal||p.role?'PERSONALIZED FROM RESULT DATA':'PERSONALIZATION-READY RESULT CONTRACT'}</span></div>`;return sec}
function rebuildProfile(s,ds){const shell=root.querySelector('.v13-shell');if(!shell)return;const naya=shell.querySelector('#v13-naya-introduction');const sec=createProfile(s,ds);if(naya)naya.insertAdjacentElement('afterend',sec);else shell.insertBefore(sec,shell.firstElementChild);}
function rewriteReport(s,ds){const report=root.querySelector('#v13-report');if(!report)return;const h=report.querySelector('.v13-h2');if(h)h.textContent='YOUR REPORT';const sub=report.querySelector('.v13-sub');if(sub){const top=strongest(ds),low=lever(ds);sub.textContent=`Listen to the result as a whole. ${top?top.name+' is your strongest visible signal. ':''}${low?'Your biggest lever is '+low.name+'.':''}`}
 const ch=report.querySelector('.v13-chapter');if(ch)ch.innerHTML='<i>02</i> YOUR REPORT';
 const quote=report.querySelector('.v13-report-quote');if(quote){const top=strongest(ds);quote.innerHTML=`<em>${top?Math.round(top.score):Math.round(s)}</em> <span>is the signal I would build around first — ${top?esc(top.name):'your strongest dimension'}.</span>`}
}
function rebuildDimensions(ds){const sec=root.querySelector('#v13-dimensions');if(!sec||ds.length!==5)return;const grid=sec.querySelector('.v13-dim-grid');if(!grid)return;grid.innerHTML='';const copy=(d)=>d.description|| (d.score>=85?'A strength you can compound.':d.score>=70?'A capable area ready to sharpen.':'A high-value area for focused improvement.');const lev=(d)=>d.score>=85?'COMPOUND IT':d.score>=70?'SHARPEN IT':'FOCUS HERE';ds.forEach((d,i)=>{const card=document.createElement('article');card.className='v13-dim';card.style.setProperty('--score',d.score);card.style.setProperty('--g',colors[i]);card.setAttribute('aria-label',`${d.name}, score ${Math.round(d.score)} out of 100`);card.innerHTML=`<div class="v15-dim-inner"><strong class="v15-dim-score">${Math.round(d.score)}</strong><span class="v15-dim-name">${esc(d.name)}</span></div><p class="v15-dim-copy">${esc(copy(d))}</p><div class="v15-dim-lever">${lev(d)}</div>`;grid.appendChild(card)});const h=sec.querySelector('.v13-h2');if(h)h.textContent='YOUR FIVE DIMENSIONS';const p=sec.querySelector('.v13-sub');if(p)p.textContent='See the five capabilities that shape how you work with AI — then notice how they combine.';const ch=sec.querySelector('.v13-chapter');if(ch)ch.innerHTML='<i>03</i> YOUR FIVE DIMENSIONS'}
function patternSvg(ds){const W=900,H=560,cx=450,cy=285,r=190;const pts=ds.map((d,i)=>{const a=-Math.PI/2+i*(Math.PI*2/5);return {x:cx+Math.cos(a)*r,y:cy+Math.sin(a)*r,score:d.score,name:d.name}});const data=pts.map(p=>`${p.x},${p.y}`).join(' ');const grid=[.25,.5,.75,1].map(k=>{const q=pts.map(p=>`${cx+(p.x-cx)*k},${cy+(p.y-cy)*k}`).join(' ');return `<polygon points="${q}" fill="none" stroke="rgba(255,255,255,.10)" stroke-width="1"/>`}).join('');const axis=pts.map(p=>`<line x1="${cx}" y1="${cy}" x2="${p.x}" y2="${p.y}" stroke="rgba(255,255,255,.08)"/>`).join('');const values=pts.map(p=>{const k=p.score/100;return `${cx+(p.x-cx)*k},${cy+(p.y-cy)*k}`}).join(' ');const nodes=pts.map((p,i)=>`<g><circle cx="${p.x}" cy="${p.y}" r="36" fill="rgba(8,7,12,.94)" stroke="${colors[i]}" stroke-width="2"/><text x="${p.x}" y="${p.y-3}" text-anchor="middle" class="v15-pattern-label">${esc(p.name).slice(0,18)}</text><text x="${p.x}" y="${p.y+28}" text-anchor="middle" class="v15-pattern-score">${Math.round(p.score)}</text></g>`).join('');return `<div class="v15-pattern-stage"><svg viewBox="0 0 ${W} ${H}" role="img" aria-labelledby="v15-pattern-title v15-pattern-desc"><title id="v15-pattern-title">Your five-dimension AI mastery pattern</title><desc id="v15-pattern-desc">A connected visual showing the five MAXESS dimensions and their scores.</desc>${grid}${axis}<polygon points="${data}" fill="rgba(150,93,255,.05)" stroke="rgba(255,255,255,.18)" stroke-width="1"/><polygon points="${values}" fill="rgba(150,93,255,.20)" stroke="#cdb1ff" stroke-width="3"/>${nodes}<circle cx="${cx}" cy="${cy}" r="42" fill="#08070d" stroke="rgba(255,255,255,.18)"/><text x="${cx}" y="${cy-3}" text-anchor="middle" fill="#fff" font-size="30" font-weight="900">${Math.round(score())}</text><text x="${cx}" y="${cy+18}" text-anchor="middle" fill="rgba(255,255,255,.45)" font-size="8" letter-spacing="2">MAXESS SCORE</text></svg><p class="v15-pattern-help">The center is your overall result. The shape around it shows how your five dimensions work together.</p></div>`}
function rebuildPattern(ds){let sec=root.querySelector('#v13-pattern');if(!sec)return;sec.id='v15-pattern';sec.classList.add('v15-pattern');const map=sec.querySelector('.v13-pattern-map');if(map)map.outerHTML=patternSvg(ds);const h=sec.querySelector('.v13-h2');if(h)h.textContent='SEE THE PATTERN';const ch=sec.querySelector('.v13-chapter');if(ch)ch.innerHTML='<i>04</i> SEE THE PATTERN';const p=sec.querySelector('.v13-sub');if(p)p.textContent='Your dimensions are not five separate scores. Together they reveal how your AI practice is shaped.'}
function rebuildStrength(s,ds){const sec=root.querySelector('#v13-strengths');if(!sec)return;const top=strongest(ds);const old=sec.querySelector('.v13-report-quote');if(old)old.remove();const card=document.createElement('div');card.className='v15-strength-card';card.innerHTML=`<div class="v15-strength-score">${top?Math.round(top.score):Math.round(s)}<small>STRONGEST SIGNAL</small></div><div><h3>${top?esc(top.name):'Your strongest signal'}</h3><p>${top?`You already have meaningful capability here. Use ${esc(top.name)} as the foundation you build the rest of your AI practice on.`:'Your strongest visible signal will appear when the five dimensions are available.'}</p></div>`;sec.querySelector('.v13-wrap')?.appendChild(card);const h=sec.querySelector('.v13-h2');if(h)h.textContent='YOUR STRENGTHS';const sub=sec.querySelector('.v13-sub');if(sub)sub.textContent='Recognition first. Then use what is already working to create more leverage.';const ch=sec.querySelector('.v13-chapter');if(ch)ch.innerHTML='<i>05</i> YOUR STRENGTHS'}
function rebuildLever(ds){const sec=root.querySelector('#v13-lever');if(!sec)return;const low=lever(ds);const layout=document.createElement('div');layout.className='v15-lever-layout';layout.innerHTML=`<div><div class="v15-lever-score">${low?Math.round(low.score):0}<small>${low?esc(low.name):'YOUR NEXT LEVER'}</small></div></div><div><h3>If I were helping you improve one thing first, I’d start here.</h3><p>${low?`Your biggest visible opportunity is ${esc(low.name)}. This is not a verdict about you. It is a high-leverage place to focus because it currently sits furthest below the rest of your five-dimension profile.`:'Your next lever will appear when the five dimensions are available.'}</p><div class="v15-lever-why"><div><b>WHY THIS ONE</b><span>It creates a focused target instead of asking you to improve everything at once.</span></div><div><b>HOW TO USE IT</b><span>Choose one real AI workflow, measure the result, improve it, and repeat.</span></div></div></div>`;const wrap=sec.querySelector('.v13-wrap');if(wrap){wrap.innerHTML='<div class="v13-chapter"><i>06</i> YOUR BIGGEST LEVER</div>';wrap.appendChild(layout)} }
function rebuildNext(sec,ds){if(!sec)return;const low=lever(ds);const intro=sec.querySelector('.v15-next-intro')||document.createElement('p');intro.className='v15-next-intro';intro.textContent=low?`Start with ${low.name}. Give yourself one focused improvement target, then use the MAXESS process to turn it into a repeatable advantage.`:'Start with one focused improvement target, then use the MAXESS process to turn it into a repeatable advantage.';const wrap=sec.querySelector('.v13-wrap');if(wrap&&!intro.parentElement)wrap.insertBefore(intro,wrap.querySelector('.v13-steps'));const h=sec.querySelector('.v13-h2');if(h)h.textContent='YOUR NEXT MOVE';const ch=sec.querySelector('.v13-chapter');if(ch)ch.innerHTML='<i>07</i> YOUR NEXT MOVE'}
function masterRelevance(name,low,top){const x=name.toLowerCase();const l=(low?.name||'').toLowerCase();const t=(top?.name||'').toLowerCase();let v=35;if(l.includes('communication')&&(x.includes('writing')||x.includes('content')||x.includes('marketing')))v=95;else if(l.includes('direction')&&(x.includes('decision')||x.includes('business')||x.includes('productivity')))v=92;else if(l.includes('evaluation')&&(x.includes('research')||x.includes('data')||x.includes('decision')))v=93;else if(l.includes('iteration')&&(x.includes('coding')||x.includes('automation')||x.includes('orchestration')))v=94;else if(l.includes('system')&&(x.includes('automation')||x.includes('orchestration')||x.includes('business')||x.includes('productivity')))v=96;else if(t&&x.includes('writing')&&t.includes('communication'))v=82;return v}
function personalizeMasters(ds){const sec=root.querySelector('#v13-masters');if(!sec)return;const low=lever(ds),top=strongest(ds);sec.querySelectorAll('.v13-master').forEach(card=>{const name=(card.querySelector('strong')?.textContent||'').replace(/^Naya\s+/,'');const rel=masterRelevance(name,low,top);let box=card.querySelector('.v15-master-relevance');if(!box){box=document.createElement('div');box.className='v15-master-relevance';card.appendChild(box)}box.innerHTML=`<span><b>PATHWAY FIT</b><em>${rel}%</em></span><i><em style="--rw:${rel}%"></em></i>${rel>=90?'<span class="v15-master-focus">Recommended focus</span>':''}`;card.style.setProperty('--g',colors[Array.from(sec.querySelectorAll('.v13-master')).indexOf(card)%colors.length]||colors[0]);card.setAttribute('aria-label',`${name}, pathway fit ${rel} percent`)});const h=sec.querySelector('.v13-h2');if(h)h.textContent='18 NAYA MASTERS';const p=sec.querySelector('.v13-sub');if(p)p.textContent='Specialist intelligences become useful once you know what you want to improve. Your pathway fit is a recommendation signal, not another assessment score.';const ch=sec.querySelector('.v13-chapter');if(ch)ch.innerHTML='<i>08</i> 18 NAYA MASTERS'}
function improveNaya(s,ds){const p=profile(),top=strongest(ds),low=lever(ds);const naya=root.querySelector('#v13-naya-introduction');if(!naya)return;const copy=naya.querySelector('.v13-naya-copy');if(copy){let msg=p.name?`${p.name}, I’ve looked at your results. `:'I’ve looked at your results. ';msg+=top?`Your strongest signal is ${top.name}. `:'';msg+=low?`Your biggest lever is ${low.name}. `:'';msg+=p.goal?`And because your goal is ${p.goal}, that is where I’d focus first.`:'Let’s turn that into one clear next move.';copy.textContent=msg}const title=naya.querySelector('.v13-naya-title');if(title)title.textContent='I’ve looked at your results. Let’s see what they’re telling us.';const btn=naya.querySelector('button,.v13-btn');if(btn){btn.setAttribute('aria-label','Listen to Naya interpret your results');btn.addEventListener('click',()=>pulseOrb(),{once:false})}}
function pulseOrb(){const orb=root.querySelector('.v13-score-orb');if(!orb)return;orb.classList.add('is-naya-speaking');window.setTimeout(()=>orb.classList.remove('is-naya-speaking'),1800)}
function wireOrb(){root.addEventListener('maxess:naya-listen',pulseOrb);root.querySelectorAll('button,a').forEach(el=>{if(/listen to naya/i.test(el.textContent||''))el.addEventListener('click',pulseOrb)});window.addEventListener('maxess:naya-speaking',pulseOrb);window.addEventListener('maxess:naya-stop',()=>root.querySelector('.v13-score-orb')?.classList.remove('is-naya-speaking'))}
function reorder(){const shell=root.querySelector('.v13-shell');if(!shell)return;const order=['.v13-hero','#v13-naya-introduction','#v15-personal-profile','#v13-report','#v13-dimensions','#v15-pattern','#v13-strengths','#v13-lever','#v13-next','#v13-masters','#v13-video','#v13-final'];order.map(s=>shell.querySelector(s)).filter(Boolean).forEach(el=>shell.appendChild(el));}
function finalChapter(){const f=root.querySelector('#v13-final');if(!f)return;const h=f.querySelector('h2');if(h)h.textContent='YOUR NEXT CHAPTER';const p=f.querySelector('p');if(p)p.textContent='You now know where you are, what is working, where the greatest return may be, and what to do next. Choose the chapter you want to build.';const note=f.querySelector('.v15-final-note')||document.createElement('p');note.className='v15-final-note';note.textContent='Your score is not the destination. It is your starting point.';if(!note.parentElement)f.querySelector('.v13-wrap')?.insertBefore(note,f.querySelector('a,.v13-preserved-cta'));const ch=f.querySelector('.v13-chapter');if(ch)ch.innerHTML='<i>10</i> YOUR NEXT CHAPTER'}
function addPrint(){if(root.querySelector('.v15-print'))return;const hero=root.querySelector('.v13-hero');if(!hero)return;const wrap=document.createElement('div');wrap.className='v15-print';wrap.innerHTML='<button type="button" aria-label="Print or save this MAXESS report as PDF">Print / Save PDF</button>';wrap.querySelector('button').addEventListener('click',()=>window.print());hero.appendChild(wrap)}
function expose(s,ds){const p=profile(),top=strongest(ds),low=lever(ds);window.MAXESS_PROFILE={schema:'MAXESS-PERSONAL-PROFILE-2',name:p.name||null,role:p.role||null,goal:p.goal||null,experienceLevel:p.experience||null,organization:p.organization||null,location:p.location||null,overallScore:Math.round(s),band:band(s),dimensions:ds,strongestSignal:top,biggestLever:low,personalized:Boolean(p.name||p.role||p.goal||p.experience||p.organization||p.location||p.bio),source:'window.MAXESS_RESULT'};root.setAttribute('data-v15-state','verified-runtime-data');root.dispatchEvent(new CustomEvent('maxess:profile-ready',{detail:window.MAXESS_PROFILE}));}
function build(){const s=score(),ds=dims();if(s===null||ds.length!==5)return false;ensureClass();const shell=root.querySelector('.v13-shell');if(!shell)return false;reorder();rebuildProfile(s,ds);rewriteReport(s,ds);rebuildDimensions(ds);rebuildPattern(ds);rebuildStrength(s,ds);rebuildLever(ds);rebuildNext(root.querySelector('#v13-next'),ds);personalizeMasters(ds);improveNaya(s,ds);finalChapter();addPrint();expose(s,ds);wireOrb();return true}
function start(){if(build()){root.dataset.v15Ready='1';return}window.setTimeout(start,120)}
if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',start,{once:true});else start();window.addEventListener('maxess:result-ready',start);
})();
