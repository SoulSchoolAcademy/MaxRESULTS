<script id="maxess-results-v13-script">
/* ================================================================
   MAXESS RESULTS V13 — DATA + EXPERIENCE ORCHESTRATOR
   ================================================================ */
(function(){
  'use strict';
  function ready(fn){
    if(document.readyState==='loading') document.addEventListener('DOMContentLoaded',fn,{once:true});
    else fn();
  }
  ready(function(){
    var root=document.getElementById('maxess-results-10');
    if(!root || root.dataset.v13Applied==='true') return;
    root.dataset.v13Applied='true';
    root.classList.add('mx-v13-active');

    var result=window.MAXESS_RESULT||{};
    var score=Number(result.overallScore ?? result.score ?? 0);
    if(!Number.isFinite(score)) score=0;
    score=Math.max(0,Math.min(100,Math.round(score)));

    function all(selector){return Array.prototype.slice.call(root.querySelectorAll(selector));}
    function text(el){return (el&&el.textContent||'').replace(/\\s+/g,' ').trim().toLowerCase();}
    function findByHeading(words){
      var candidates=all('.mx-section,.mx-growth,.mx-naya-playground,.mx-naya-bridge,.mx-final');
      return candidates.find(function(sec){
        var t=text(sec);
        return words.some(function(w){return t.indexOf(w.toLowerCase())!==-1;});
      });
    }
    function setText(selector,value){var el=root.querySelector(selector);if(el)el.textContent=value;return el;}

    /* Build the score reveal without deleting the existing score/orb. */
    var hero=root.querySelector('.mx-hero');
    var grid=hero&&hero.querySelector('.mx-hero-grid');
    var orb=hero&&hero.querySelector('.mx-score-orb');
    if(hero&&grid&&orb){
      hero.classList.add('v13-hero');
      grid.classList.add('v13-hero-grid');
      var scoreLabel=document.createElement('div');
      scoreLabel.className='v13-score-label';
      scoreLabel.textContent='YOUR AI SCORE';
      var scoreValue=document.createElement('div');
      scoreValue.className='v13-score-value';
      scoreValue.textContent=String(score);
      scoreValue.setAttribute('aria-label','Your AI score is '+score+' out of 100');
      var caption=document.createElement('div');
      caption.className='v13-score-caption';
      caption.textContent='AI MASTERY · '+(result.band||'YOUR RESULTS');
      var wrap=document.createElement('div');
      wrap.className='v13-orb-wrap';
      orb.parentNode.insertBefore(wrap,orb);
      wrap.appendChild(orb);
      var existingHeroCopy=grid.querySelector(':scope > div:first-child');
      grid.insertBefore(scoreLabel,grid.firstChild);
      grid.insertBefore(scoreValue,scoreLabel.nextSibling);
      grid.insertBefore(caption,scoreValue.nextSibling);
      if(existingHeroCopy && existingHeroCopy!==scoreLabel && existingHeroCopy!==scoreValue && existingHeroCopy!==caption){
        var actions=existingHeroCopy.querySelector('.mx-hero-actions');
        if(actions){
          actions.classList.add('v13-hero-actions');
          grid.appendChild(actions);
        }
        existingHeroCopy.classList.add('v13-hide-report-noise');
      }
    }

    /* Turn the existing Naya welcome into the first human conversation. */
    var welcome=root.querySelector('.v11-naya-welcome');
    var nayaReport=root.querySelector('#naya-report');
    var nayaImg=(root.querySelector('img[alt*="Naya" i]')||root.querySelector('.v11-naya-avatar'));
    var naya=document.createElement('section');
    naya.className='mx-section';
    naya.id='v13-naya-introduction';
    naya.innerHTML='<div class="v13-naya-intro"><div class="v13-naya-image-slot"></div><div><span class="v13-naya-kicker">NAYA · YOUR GUIDE</span><h2 class="v13-naya-title">Hi. I’ve looked at your results.</h2><p class="v13-naya-copy">This isn’t a judgment. It’s a map. I’m here to help you understand what you already do well, where your biggest opportunity is, and what to do next.</p><span class="v13-naya-signature">Technology should amplify your human.</span></div></div>';
    var imageSlot=naya.querySelector('.v13-naya-image-slot');
    if(nayaImg){
      var clone=nayaImg.cloneNode(true);
      clone.removeAttribute('id');
      imageSlot.appendChild(clone);
    }else{
      imageSlot.innerHTML='<div style="width:92px;height:92px;border-radius:50%;display:grid;place-items:center;background:radial-gradient(circle at 35% 30%,#fff, #caa8ff 18%, #7440c4 55%, #160b25 100%);color:#fff;font-size:30px;font-weight:900;box-shadow:0 0 0 7px rgba(154,98,255,.08),0 18px 42px rgba(0,0,0,.30)">N</div>';
    }
    if(welcome) welcome.remove();
    if(nayaReport) nayaReport.classList.add('v13-hide-report-noise');
    if(hero) hero.insertAdjacentElement('afterend',naya);

    /* Rewrite the redundant final sentence that previously blocked the flow. */
    var final=root.querySelector('.mx-final');
    if(final){
      final.classList.add('v13-final-report');
      var note=final.querySelector('.mx-final-note');
      if(note) note.remove();
    }

    /* Label the major chapters and assign the intended narrative order. */
    var dimension=findByHeading(['02 · what it means','every score has']);
    if(dimension) dimension.classList.add('v13-dimension-section','v13-chapter-anchor');
    var fingerprint=root.querySelector('#your-fingerprint')||root.querySelector('#v11-fingerprint');
    if(fingerprint) fingerprint.classList.add('v13-pattern-section','v13-chapter-anchor');
    var strengths=findByHeading(['03 · your advantage','what you already']);
    if(strengths) strengths.classList.add('v13-story-section','v13-chapter-anchor');
    var next=findByHeading(['04 · your next chapter','from capability']);
    if(next) next.classList.add('v13-next-section','v13-chapter-anchor');
    var pathways=findByHeading(['05 · your 18 ai pathways','don’t learn ai','do not learn ai']);
    if(pathways) pathways.classList.add('v13-pathways-section','v13-chapter-anchor');

    /* Remove the redundant commercial CTA from the middle growth card; preserve the actual CTA later. */
    var growth=root.querySelector('#growth-scorecard');
    if(growth){
      var growthCta=growth.querySelector('.mx-growth-cta');
      if(growthCta) growthCta.classList.add('v13-hide-report-noise');
      var micro=growth.querySelector('.mx-micro');
      if(micro) micro.classList.add('v13-hide-report-noise');
    }

    /* Make pathway relevance personalized from actual dimension scores when possible. */
    var dims=Array.isArray(result.dimensions)?result.dimensions:[];
    var scoreMap={};
    dims.forEach(function(d){if(d&&d.name!=null)scoreMap[text({textContent:d.name})]=Number(d.score)||0;});
    all('.mx-area').forEach(function(area){
      area.setAttribute('tabindex','0');
      var button=area.querySelector('.mx-mini');
      if(button){
        button.setAttribute('aria-label','Explore '+(area.getAttribute('data-name')||'this pathway'));
      }
    });

    /* Make the existing hard-coded score presentation match the authoritative result. */
    all('.mx-score strong,.mx-radar-center b').forEach(function(el){el.textContent=String(score);});
    all('.mx-hero .mx-score span').forEach(function(el){el.textContent='MAXESS SCORE';});

    /* Kill the old dead-end sentence everywhere it occurs. */
    all('*').forEach(function(el){
      if(el.children.length===0 && text(el)==='the results chapter is complete. the next chapter is nayanet.'){
        el.textContent='';
        el.classList.add('v13-hide-report-noise');
      }
    });

    /* Smooth, accessible chapter navigation for the single primary action. */
    all('a[href="#naya-report"],a[href="#naya-playground"]').forEach(function(a){
      a.addEventListener('click',function(e){
        var target=root.querySelector('#v13-naya-introduction')||naya;
        if(target){e.preventDefault();target.scrollIntoView({behavior:'smooth',block:'start'});}
      });
    });

    /* Re-run reveal observers for dynamically moved/created content. */
    var observer=('IntersectionObserver' in window)?new IntersectionObserver(function(entries){
      entries.forEach(function(entry){if(entry.isIntersecting)entry.target.classList.add('is-visible');});
    },{threshold:.12}):null;
    if(observer) all('.mx-reveal').forEach(function(el){observer.observe(el);});

    console.log('%cMAXESS RESULTS V13 EXECUTED','color:#55dfff;font-weight:900;font-size:16px');
    root.setAttribute('data-results-version','13');
    root.setAttribute('data-execution-status','material-change-applied');
  });
})();
</script>
