<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="#000"><title>MAXESS — E04</title><style>#e04{min-height:620px;background:#000;color:#fff;font-family:Inter,system-ui,sans-serif;padding:70px 24px 90px;box-sizing:border-box}#e04 *{box-sizing:border-box}.e04-shell{width:min(1120px,100%);margin:auto}.e04-head{text-align:center}.e04-kicker{font-size:10px;letter-spacing:.3em;color:#aaa3b5}.e04-title{font:400 clamp(40px,6vw,66px)/1 Georgia,serif;margin:15px 0}.e04-score{width:78px;height:78px;margin:30px auto 40px;border:1px solid rgba(255,255,255,.35);border-radius:50%;display:grid;place-items:center;font-size:25px;font-weight:900}.e04-bar{position:relative;height:34px;display:flex;border:1px solid rgba(255,255,255,.26);border-radius:999px;margin-top:25px}.e04-seg.foundation{width:50%;background:#e52b42;border-radius:999px 0 0 999px}.e04-seg.developing{width:25%;background:#ffad18}.e04-seg.advancing{width:15%;background:#39d36b}.e04-seg.mastery{width:10%;background:#8d63ff;border-radius:0 999px 999px 0}.e04-marker{position:absolute;top:-18px;left:0;transform:translateX(-50%);width:66px;height:66px;border:2px solid #fff;border-radius:50%;display:grid;place-items:center;background:#050505;font-weight:900;box-shadow:0 0 30px rgba(141,99,255,.35)}.e04-labels{display:flex;margin-top:17px;text-align:center;font-size:10px;font-weight:900;letter-spacing:.12em}.e04-labels span:nth-child(1){width:50%;color:#ff5365}.e04-labels span:nth-child(2){width:25%;color:#ffd32e}.e04-labels span:nth-child(3){width:15%;color:#63e7b0}.e04-labels span:nth-child(4){width:10%;color:#9c74ff}.e04-stage{text-align:center;margin-top:30px;font-size:10px;letter-spacing:.2em;color:#cbb7e8}.e04-letter{max-width:860px;margin:42px auto 0;padding:30px 38px;border-top:1px solid rgba(255,255,255,.14);border-bottom:1px solid rgba(255,255,255,.12);font:clamp(17px,1.7vw,21px)/1.78 Georgia,serif}.e04-wait{margin-top:25px;text-align:center;color:#8e8998;font-size:10px;letter-spacing:.16em;text-transform:uppercase}@media(max-width:760px){#e04{padding:52px 17px 62px}.e04-title{font-size:42px}.e04-bar{height:29px}.e04-marker{width:58px;height:58px}.e04-labels{font-size:8px}.e04-letter{padding:28px 20px;font-size:16px}}@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}</style></head><body><section id="e04"><div class="e04-shell"><header class="e04-head"><div class="e04-kicker">MAXESS · CAPABILITY PROFILE</div><h1 class="e04-title">Your Direction</h1><div class="e04-score" id="e04-score">—</div></header><div class="e04-bar"><div class="e04-seg foundation"></div><div class="e04-seg developing"></div><div class="e04-seg advancing"></div><div class="e04-seg mastery"></div><div class="e04-marker" id="e04-marker">—</div></div><div class="e04-labels"><span>Foundation</span><span>Developing</span><span>Advancing</span><span>Mastery</span></div><div class="e04-stage" id="e04-stage">RESULT PENDING</div><article class="e04-letter"><div id="e04-copy"><strong>Your Direction result is awaiting the MAXESS result contract.</strong> This section will populate from your real result.</div></article><div class="e04-wait" id="e04-wait">Awaiting your MAXESS result</div></div></section><script>'use strict';
function readResult(){const c=[];try{c.push(window.MAXESS_RESULT)}catch(e){}try{if(window.parent&&window.parent!==window)c.push(window.parent.MAXESS_RESULT)}catch(e){}try{if(window.top&&window.top!==window)c.push(window.top.MAXESS_RESULT)}catch(e){}for(const r of c)if(r&&r.contractVersion==='MAXESS_RESULT_V1')return r;for(const store of [sessionStorage,localStorage])try{const r=JSON.parse(store.getItem('MAXESS_RESULT_V1')||'null');if(r&&r.contractVersion==='MAXESS_RESULT_V1')return r}catch(e){}try{const raw=new URLSearchParams(location.hash.replace(/^#/,'' )).get('maxess-result');if(raw){const s=raw.replace(/-/g,'+').replace(/_/g,'/');const bin=atob(s.padEnd(s.length+((4-s.length%4)%4),'='));const r=JSON.parse(new TextDecoder().decode(Uint8Array.from(bin,c=>c.charCodeAt(0))));if(r&&r.contractVersion==='MAXESS_RESULT_V1')return r}}catch(e){}return null}function onResult(fn){fn(readResult());['MAXESS_RESULT_READY','maxess:result-updated','storage','hashchange'].forEach(n=>window.addEventListener(n,e=>fn(e&&e.detail||readResult())));let i=0;const t=setInterval(()=>{fn(readResult());if(readResult()||++i>40)clearInterval(t)},250)}function render(r){const s=document.getElementById('e04-score'),m=document.getElementById('e04-marker'),st=document.getElementById('e04-stage'),c=document.getElementById('e04-copy'),w=document.getElementById('e04-wait');if(!r){s.textContent='—';m.textContent='—';m.style.left='0%';st.textContent='RESULT PENDING';c.innerHTML='<strong>Your Direction result is awaiting the MAXESS result contract.</strong> This section will populate from your real result.';w.hidden=false;return}const d=Array.isArray(r.dimensions)?r.dimensions.find(x=>String(x.id||'').toLowerCase()==='direction'):null;const v=d&&Number.isFinite(Number(d.score))?Math.max(0,Math.min(100,Number(d.score))):null;if(v===null){s.textContent='—';m.textContent='—';st.textContent='INVALID DIRECTION RESULT';w.hidden=false;return}const band=v<50?'FOUNDATION':v<75?'DEVELOPING':v<90?'ADVANCING':'MASTERY';s.textContent=Math.round(v);m.textContent=Math.round(v);m.style.left=v+'%';st.textContent=band+' · '+Math.round(v)+'/100';c.innerHTML='<strong>Your Direction capability is '+band+'.</strong> Your real dimension score is '+Math.round(v)+' out of 100. This reflects how consistently you define the destination, context, and intended outcome when working with AI.';w.hidden=true}onResult(render);</script></body></html>