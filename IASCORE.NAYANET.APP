<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#050509">
<title>MAXESS — AI Mastery Assessment</title>
<style>
:root{--bg:#050509;--panel:#0b0b12;--text:#faf9ff;--muted:#b8b4c3;--purple:#9568ff;--purple2:#c3a8ff;--line:rgba(255,255,255,.12);--ease:cubic-bezier(.2,.8,.2,1)}
*{box-sizing:border-box}html,body{margin:0;min-height:100%;background:var(--bg);color:var(--text);font-family:Inter,system-ui,sans-serif}body{overflow-x:hidden}button{font:inherit}button:focus-visible{outline:2px solid #fff;outline-offset:4px}
.app{min-height:100dvh;padding:12px;background:radial-gradient(circle at 50% -8%,rgba(126,76,255,.18),transparent 34%),#050509}.shell{width:min(1180px,100%);min-height:calc(100dvh - 24px);margin:auto;display:flex;flex-direction:column}.top{display:grid;grid-template-columns:auto minmax(0,1fr);gap:18px;align-items:center;margin-bottom:12px}.brand{font-size:clamp(19px,2vw,25px);font-weight:950;letter-spacing:.15em}.brand span{color:#b895ff}.progress{justify-self:center;width:min(440px,100%);display:flex;align-items:center;gap:10px;padding:8px 12px;border:1px solid var(--line);border-radius:999px;background:rgba(255,255,255,.04)}.progress-track{height:6px;flex:1;background:rgba(255,255,255,.07);border-radius:99px;overflow:hidden}.progress-fill{display:block;width:0;height:100%;background:linear-gradient(90deg,#6636d9,#9568ff,#c3a8ff);transition:width .35s ease}.progress-label,.progress-percent{font-size:9px;font-weight:900;letter-spacing:.1em;white-space:nowrap}.board{flex:1;display:flex;border:1px solid rgba(149,104,255,.48);border-radius:30px;overflow:hidden;background:linear-gradient(180deg,#08080d,#050508);box-shadow:0 28px 80px rgba(0,0,0,.65),0 0 75px rgba(83,40,180,.09)}.content{width:100%;padding:clamp(22px,3vw,36px);display:flex;flex-direction:column}.command{display:flex;justify-content:space-between;align-items:center;gap:14px;margin-bottom:clamp(18px,2.5vw,30px)}.naya-btn,.continue{min-height:55px;border-radius:18px;border:1px solid rgba(181,140,255,.72);color:#fff;cursor:pointer;background:#0b0a10;box-shadow:0 12px 30px rgba(0,0,0,.5),0 0 30px rgba(149,104,255,.12);transition:.2s ease}.naya-btn{display:flex;align-items:center;gap:10px;padding:6px 15px 6px 7px}.naya-btn:hover,.continue:hover:not(:disabled){transform:translateY(-2px);border-color:#c9b1ff}.naya-img{width:40px;height:40px;border-radius:50%;object-fit:cover;border:1px solid #fff;box-shadow:0 0 20px rgba(149,104,255,.38)}.naya-copy{display:flex;flex-direction:column;text-align:left;line-height:1.05}.naya-copy strong{font-size:14px}.naya-copy span{margin-top:5px;color:#c9c4d4;font-size:10px}.continue{min-width:190px;padding:0 22px;font-size:14px;font-weight:950}.continue:disabled{opacity:.55;cursor:not-allowed}.question{width:min(960px,100%);margin:0 auto;text-align:center}.eyebrow{display:inline-flex;gap:8px;margin-bottom:12px;color:#c3a8ff;font-size:11px;font-weight:950;letter-spacing:.17em;text-transform:uppercase}h1{margin:0;font-size:clamp(27px,4vw,49px);line-height:1.08;letter-spacing:-.035em}.rule{width:180px;height:1px;margin:18px auto;background:linear-gradient(90deg,transparent,#9568ff,transparent)}.answers{width:min(880px,100%);margin:24px auto 0;display:grid;gap:9px}.answer{--accent:#9568ff;width:100%;min-height:68px;display:grid;grid-template-columns:54px minmax(0,1fr) 32px;align-items:center;gap:13px;padding:7px;border:1px solid rgba(255,255,255,.105);border-radius:20px;color:#fff;text-align:left;cursor:pointer;background:linear-gradient(180deg,#121219,#08080c);transition:.2s ease}.answer:hover,.answer.selected{transform:translateY(-2px);border-color:#c3a8ff;box-shadow:0 0 30px rgba(149,104,255,.15)}.jewel{width:52px;height:52px;display:grid;place-items:center;border-radius:17px;background:radial-gradient(circle at 28% 20%,#fff,#d9cbff 12%,var(--accent) 42%,#120a25 100%);border:1px solid rgba(255,255,255,.72)}.answer-title{display:block;font-size:clamp(14px,1.55vw,17px);font-weight:900}.answer-sub{display:block;margin-top:7px;color:#ddd9e5;font-size:clamp(13px,1.4vw,15px);line-height:1.3}.chevron{width:30px;height:30px;display:grid;place-items:center;border:1px solid rgba(255,255,255,.11);border-radius:50%}.footer{margin-top:12px;text-align:center;color:#57535f;font-size:8px;font-weight:800;letter-spacing:.14em;text-transform:uppercase}.hidden{display:none!important}.dialog{position:fixed;inset:0;z-index:20;display:none;place-items:center;padding:22px;background:rgba(0,0,0,.78);backdrop-filter:blur(18px)}.dialog.open{display:grid}.dialog-card{width:min(690px,100%);padding:34px 38px 30px;text-align:center;border:1px solid rgba(195,168,255,.38);border-radius:40px;background:#0b0910;box-shadow:0 35px 100px rgba(0,0,0,.75)}.presence{display:flex;align-items:center;justify-content:center;gap:13px;margin-bottom:22px}.presence img{width:56px;height:56px;border-radius:50%;object-fit:cover;border:1px solid #fff}.presence-copy{text-align:left}.presence-copy strong{display:block;font-size:18px}.presence-copy span{display:block;margin-top:4px;color:#c9c4d4;font-size:12px}.dialog-kicker{color:#cdb7ff;font-size:10px;font-weight:950;letter-spacing:.2em;text-transform:uppercase}.dialog-title{margin:9px 0 0;font-size:clamp(26px,4vw,38px)}.dialog-body{max-width:560px;margin:16px auto 0;color:#ddd9e5;font-size:clamp(15px,2vw,18px);line-height:1.55}.dialog-actions{display:flex;justify-content:center;gap:11px;margin-top:26px;flex-wrap:wrap}.dialog-btn{min-height:53px;padding:0 24px;border-radius:17px;border:1px solid rgba(195,168,255,.7);background:#09090d;color:#fff;font-weight:950;cursor:pointer}@media(max-width:760px){.app{padding:7px 5px}.board{border-radius:21px}.content{padding:13px 8px}.top{gap:8px}.brand{font-size:16px}.progress{justify-self:end;padding:7px 9px}.naya-btn,.continue{min-height:47px;height:47px;border-radius:15px}.naya-img{width:35px;height:35px}.naya-copy span{display:none}.continue{min-width:0;padding:0 14px;font-size:13px}.answer{min-height:60px;grid-template-columns:43px minmax(0,1fr) 25px;gap:9px;padding:5px;border-radius:16px}.jewel{width:42px;height:42px;border-radius:13px}.answer-title{font-size:13.2px}.answer-sub{font-size:12.8px;margin-top:5px}.dialog-card{padding:28px 20px}.dialog-actions{flex-direction:column}.dialog-btn{width:100%}}@media(prefers-reduced-motion:reduce){*,*:before,*:after{animation:none!important;transition:none!important}}
</style>
</head><body><main class="app"><div class="shell"><header class="top"><div class="brand">MAX<span>ESS</span></div><div class="progress" aria-live="polite"><span class="progress-label" id="progressLabel">QUESTION 1 OF 15</span><span class="progress-track"><span class="progress-fill" id="progressFill"></span></span><span class="progress-percent" id="progressPercent">7%</span></div></header><section class="board"><div class="content"><div id="assessmentStage"><div class="command"><button class="naya-btn" id="nayaButton" type="button" aria-haspopup="dialog"><img class="naya-img" src="https://raw.githubusercontent.com/SoulSchoolAcademy/MaxRESULTS/main/Naya%20Profile%206.jpg" alt="Naya"><span class="naya-copy"><strong>Naya</strong><span>Help me understand this</span></span></button><button class="continue" id="continueButton" type="button" disabled>Continue →</button></div><div class="question"><div class="eyebrow" id="questionLabel">DIRECTION</div><h1 id="questionTitle"></h1><div class="rule"></div></div><div class="answers" id="answers" role="group" aria-label="Answer choices"></div></div><div id="completeStage" class="hidden" style="max-width:760px;margin:auto;text-align:center"><img src="https://raw.githubusercontent.com/SoulSchoolAcademy/MaxRESULTS/main/Naya%20Profile%206.jpg" alt="Naya" style="width:120px;height:120px;border-radius:50%;object-fit:cover;border:2px solid #fff;box-shadow:0 0 45px rgba(149,104,255,.34)"><h2 style="font-size:clamp(32px,5vw,54px)">Your personal report is ready.</h2><p style="color:var(--muted);font-size:17px;line-height:1.6">Your real MAXESS result has been prepared. Continue to your report.</p><button class="continue" id="continueToResults" type="button">Continue to My Report →</button></div></div></section><footer class="footer">MAXESS · AI Mastery Assessment</footer></div></main><div class="dialog" id="nayaDialog" role="dialog" aria-modal="true"><div class="dialog-card"><div class="presence"><img src="https://raw.githubusercontent.com/SoulSchoolAcademy/MaxRESULTS/main/Naya%20Profile%206.jpg" alt="Naya"><div class="presence-copy"><strong>Naya</strong><span>Let me walk you through this.</span></div></div><div class="dialog-kicker" id="dialogKicker"></div><h2 class="dialog-title" id="dialogTitle"></h2><div class="dialog-body" id="dialogBody"></div><div class="dialog-actions"><button class="dialog-btn" id="playNaya" type="button">PLAY NAYA ▶</button><button class="dialog-btn" id="closeNaya" type="button">Got it — let's go →</button></div></div></div>
<script>
'use strict';
const QUESTIONS=[{id:'q01',dimensionId:'direction',question:'When you ask AI to create something important, how clearly do you define the destination?',answers:[['a','Extremely clearly','I define the destination precisely.',1],['b','Very clearly','I usually know what great looks like.',2],['c','Fairly clearly','I give AI a clear direction, then refine it.',4],['d','Somewhat clearly','I have the destination, but it evolves.',3],['e','I figure it out as I go','The first result often helps me discover what I want.',4]]},{id:'q02',dimensionId:'direction',question:'How clearly do you communicate what you want AI to understand, create, or change?',answers:[['a','Extremely clearly','I communicate the outcome, context, constraints, and important details.',4],['b','Very clearly','AI usually understands exactly what I mean.',2],['c','Fairly clearly','I communicate the main idea and refine details later.',3],['d','Somewhat clearly','Sometimes AI understands me, sometimes I need to clarify.',4],['e','I explain it as I go','I discover what I mean through the conversation.',1]]},{id:'q03',dimensionId:'direction',question:'How consistently do you give AI the context it needs before asking it to solve an important problem?',answers:[['a','Almost always','I make sure AI understands the situation first.',1],['b','Very often','I provide context whenever the task matters.',3],['c','Often','I usually give useful background information.',1],['d','Sometimes','I add context when AI gets confused.',3],['e','Rarely','I usually get straight to the request.',4]]},{id:'q04',dimensionId:'context',question:'How effectively do you explain your intended audience, purpose, and desired outcome to AI?',answers:[['a','Extremely effectively','Audience and purpose are always part of my direction.',3],['b','Very effectively','I usually make the audience clear.',2],['c','Fairly effectively','I explain it when it is important.',1],['d','Sometimes','I think about the audience after the first result.',3],['e','Rarely','I mostly let AI decide how to present it.',4]]},{id:'q05',dimensionId:'context',question:'How consistently do you give AI the background information that changes how a problem should be solved?',answers:[['a','Almost always','I make sure AI has the relevant situation first.',3],['b','Very often','I provide important background whenever it matters.',4],['c','Often','I usually provide useful background.',2],['d','Sometimes','I add background when the first answer misses context.',3],['e','Rarely','I usually start with the immediate request.',1]]},{id:'q06',dimensionId:'context',question:'How well do you recognize which details are important enough for AI to know before it begins?',answers:[['a','Extremely well','I quickly identify the details that materially affect the outcome.',2],['b','Very well','I usually know what context matters most.',3],['c','Fairly well','I identify the major details and refine later.',2],['d','Somewhat well','I often discover important context during the conversation.',3],['e','Not very well yet','I tend to provide details only when they become necessary.',4]]},{id:'q07',dimensionId:'collaboration',question:'How effectively do you correct AI when it misunderstands what you want?',answers:[['a','Extremely effectively','I diagnose the misunderstanding and redirect precisely.',1],['b','Very effectively','I usually correct AI quickly.',2],['c','Fairly effectively','I can usually get things back on track.',3],['d','Sometimes','I often need several attempts.',3],['e','Not very effectively','I often abandon the direction and start again.',4]]},{id:'q08',dimensionId:'collaboration',question:'How effectively do you use feedback from one AI result to produce a better next result?',answers:[['a','Extremely effectively','Every revision gives AI specific information about what to improve.',1],['b','Very effectively','I usually give useful feedback and get better results.',2],['c','Fairly effectively','I make useful corrections as I go.',2],['d','Sometimes','My feedback is often fairly general.',3],['e','Not very effectively','I often start over instead of diagnosing the issue.',4]]},{id:'q09',dimensionId:'collaboration',question:'When AI gives you a result that is close but not quite right, how do you normally work with it?',answers:[['a','Diagnose and improve it','I identify what is missing and direct the next version.',4],['b','Refine it','I give feedback and continue improving the result.',3],['c','Try another version','I ask AI to make another attempt.',2],['d','Make a few changes','I fix obvious issues and move forward.',3],['e','Usually accept it','I normally use the first useful result.',0]]},{id:'q10',dimensionId:'evaluation',question:'When AI gives you an answer, how deliberately do you judge whether it is actually good enough?',answers:[['a','Very deliberately','I use clear standards and actively look for weaknesses.',2],['b','Usually deliberately','I regularly inspect quality before accepting the result.',3],['c','Sometimes','I evaluate important outputs but not everything.',2],['d','Occasionally','I usually know when something feels wrong.',3],['e','Rarely','If the answer looks useful, I usually move on.',4]]},{id:'q11',dimensionId:'evaluation',question:'How consistently do you verify important AI-generated information before relying on it?',answers:[['a','Almost always','I verify important claims before relying on them.',3],['b','Very often','I verify information when accuracy matters.',1],['c','Often','I check important information most of the time.',2],['d','Sometimes','I verify things when something feels questionable.',3],['e','Rarely','I generally trust useful-looking answers.',4]]},{id:'q12',dimensionId:'evaluation',question:'How often do you deliberately look for what could be wrong with an AI-generated result?',answers:[['a','Almost always','I actively challenge important outputs.',2],['b','Very often','I deliberately look for weaknesses.',1],['c','Often','I check important results for obvious problems.',4],['d','Sometimes','I inspect results when something feels off.',3],['e','Rarely','I usually focus on what is useful.',0]]},{id:'q13',dimensionId:'iteration',question:'When the first AI result is not a 10, what do you normally do?',answers:[['a','Diagnose and improve it','I identify exactly why it is not a 10 and direct AI to improve it.',4],['b','Refine it','I give feedback and continue improving the result.',2],['c','Try another version','I ask AI to make another attempt.',3],['d','Make a few changes','I fix obvious issues and move forward.',1],['e','Usually accept it','I normally use the first useful result.',3]]},{id:'q14',dimensionId:'iteration',question:'How intentionally do you preserve what is already working while improving what is not?',answers:[['a','Extremely intentionally','I protect what works while targeting specific weaknesses.',4],['b','Very intentionally','I usually preserve strong elements during revisions.',1],['c','Fairly intentionally','I try not to lose good parts.',2],['d','Sometimes','Improvement sometimes changes more than necessary.',2],['e','Rarely','I often replace the whole thing when revising.',4]]},{id:'q15',dimensionId:'iteration',question:'How effectively do you turn individual AI successes into a larger repeatable capability?',answers:[['a','Extremely effectively','I turn successful experiments into durable capability.',3],['b','Very effectively','I regularly capture and reuse what works.',2],['c','Fairly effectively','I reuse some successful approaches.',3],['d','Sometimes','I remember useful methods but do not formalize them.',4],['e','Rarely','Most successes stay as one-off experiences.',1]]}];
const DIMENSIONS=[{id:'direction',name:'Direction'},{id:'context',name:'Context'},{id:'collaboration',name:'Collaboration'},{id:'evaluation',name:'Evaluation'},{id:'iteration',name:'Iteration'}];const BAND=s=>s<50?'foundation':s<75?'developing':s<90?'advancing':'mastery';const state={index:0,selected:null,responses:[],firstVisit:true,nayaText:''};const $=id=>document.getElementById(id);const esc=v=>String(v).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[c]));
function answers(q){return q.answers.map((a,i)=>({id:a[0],title:a[1],description:a[2],score:a[3],glyph:['◆','✦','△','✧','✦'][i]}))}function render(){const q=QUESTIONS[state.index];state.selected=null;$("questionLabel").textContent=q.dimensionId.toUpperCase();$("questionTitle").textContent=q.question;$("answers").innerHTML='';answers(q).forEach(a=>{const b=document.createElement('button');b.className='answer';b.type='button';b.dataset.id=a.id;b.innerHTML='<span class="jewel">'+a.glyph+'</span><span><span class="answer-title">'+esc(a.title)+'</span><span class="answer-sub">'+esc(a.description)+'</span></span><span class="chevron">›</span>';b.onclick=()=>{state.selected=a.id;document.querySelectorAll('.answer').forEach(x=>x.classList.toggle('selected',x===b));$("continueButton").disabled=false};$("answers").appendChild(b)});const n=state.index+1,p=Math.round(n/15*100);$("progressLabel").textContent=`QUESTION ${n} OF 15`;$('progressFill').style.width=p+'%';$('progressPercent').textContent=p+'%';$('continueButton').disabled=true}
function save(){const q=QUESTIONS[state.index],a=answers(q).find(x=>x.id===state.selected);if(!a)throw Error('No answer selected');state.responses.push({questionId:q.id,dimensionId:q.dimensionId,answerId:a.id,score:a.score})}function calculate(){if(state.responses.length!==15)throw Error('All 15 questions are required');const dimensions=DIMENSIONS.map(d=>{const rs=state.responses.filter(r=>r.dimensionId===d.id);if(rs.length!==3)throw Error('Invalid dimension response count');return {...d,score:Math.round(rs.reduce((s,r)=>s+r.score,0)/12*100)}});const overallScore=Math.round(state.responses.reduce((s,r)=>s+r.score,0)/60*100);return {overallScore,masteryBand:BAND(overallScore),dimensions}}function contract(){const r=calculate(),sorted=[...r.dimensions].sort((a,b)=>b.score-a.score);return {contractVersion:'MAXESS_RESULT_V1',assessmentId:'ai-mastery',assessmentVersion:'AISCORE-NAYA-V2',completedAt:new Date().toISOString(),overallScore:r.overallScore,masteryBand:r.masteryBand,dimensions:r.dimensions.map(d=>({...d,band:BAND(d.score)})),fiveDimensions:r.dimensions.map(d=>({...d,band:BAND(d.score)})),strongestDimension:{...sorted[0],band:BAND(sorted[0].score)},opportunityDimension:{...sorted.at(-1),band:BAND(sorted.at(-1).score)},strongestCapability:sorted[0].name,opportunityCapability:sorted.at(-1).name,responses:state.responses,selectedInterests:[],naya:{overallNarrativeId:r.masteryBand,dimensionNarratives:r.dimensions.map(d=>({dimensionId:d.id,band:BAND(d.score)}))}}}function encode(o){const bytes=new TextEncoder().encode(JSON.stringify(o));let s='';for(const b of bytes)s+=String.fromCharCode(b);return btoa(s).replace(/\+/g,'-').replace(/\//g,'_').replace(/=+$/,'')}function publish(){const c=contract();try{sessionStorage.setItem('MAXESS_RESULT_V1',JSON.stringify(c));localStorage.setItem('MAXESS_RESULT_V1',JSON.stringify(c))}catch(e){}window.MAXESS_RESULT=c;window.dispatchEvent(new CustomEvent('MAXESS_RESULT_READY',{detail:c}));window.dispatchEvent(new CustomEvent('maxess:result-updated',{detail:c}));location.assign('https://results.nayanet.app/#maxess-result='+encode(c))}
function openNaya(){const q=QUESTIONS[state.index];$("dialogKicker").textContent=state.firstVisit?'WELCOME · MAXESS AI MASTERY ASSESSMENT':q.dimensionId.toUpperCase()+' · QUESTION '+(state.index+1);$("dialogTitle").textContent=state.firstVisit?"Hi, I'm Naya.":"Here's what we're really looking at.";state.nayaText=state.firstVisit?"Hi, I'm Naya. I'll walk you through this assessment. It takes about three minutes. Answer honestly based on what you actually do today.":q.question;$("dialogBody").textContent=state.nayaText;$("playNaya").hidden=state.firstVisit;$("nayaDialog").classList.add('open')}function closeNaya(){state.firstVisit=false;$("nayaDialog").classList.remove('open');$("nayaButton").focus()}function next(){if(!state.selected)return;save();if(state.index===14){$("assessmentStage").classList.add('hidden');$("completeStage").classList.remove('hidden');$("continueToResults").focus();return}state.index++;render()}
$("nayaButton").onclick=openNaya;$("closeNaya").onclick=closeNaya;$("playNaya").onclick=()=>{state.firstVisit=false;try{speechSynthesis.speak(new SpeechSynthesisUtterance(state.nayaText))}catch(e){}$("nayaDialog").classList.remove('open')};$("continueButton").onclick=next;$("continueToResults").onclick=publish;render();window.MAXESS_AISCORE={questions:QUESTIONS,dimensions:DIMENSIONS,calculate,contract,publish};window.MAXESS_CLEAN_V2=true;
</script></body></html>