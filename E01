<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="#05030a"><title>MAXESS — E01</title><style>#e01{min-height:100vh;background:radial-gradient(circle at 50% 0,rgba(166,108,255,.2),transparent 45%),#05030a;color:#fff;font-family:Inter,system-ui,sans-serif;padding:32px 18px 70px;box-sizing:border-box}#e01 *{box-sizing:border-box}.e01-shell{width:min(1160px,100%);margin:auto}.e01-naya{display:grid;grid-template-columns:auto 1fr auto;gap:26px;align-items:center;padding:28px;border:1px solid rgba(255,255,255,.2);border-radius:32px;background:linear-gradient(145deg,#030303,#0b0710);box-shadow:0 30px 90px rgba(0,0,0,.7),0 0 70px rgba(149,104,255,.12)}.e01-avatar{width:124px;height:124px;border-radius:50%;object-fit:cover;border:2px solid #fff;box-shadow:0 0 45px rgba(149,104,255,.35)}.e01-kicker{font-size:10px;letter-spacing:.28em;font-weight:900;color:#d9c7ff}.e01-title{font-size:clamp(28px,4vw,46px);margin:8px 0}.e01-sub{font-size:16px;line-height:1.55;color:#ddd9e5}.e01-listen{min-width:210px;min-height:58px;border-radius:999px;border:1px solid #fff;background:#100b16;color:#fff;font-weight:900;cursor:pointer}.e01-score{display:grid;place-items:center;width:min(540px,100%);aspect-ratio:1;margin:50px auto 20px;border-radius:50%;background:radial-gradient(circle,#2b183f 0 18%,#110b18 48%,#05030a 72%);border:1px solid rgba(195,168,255,.5);box-shadow:0 0 100px rgba(149,104,255,.22),inset 0 0 100px rgba(149,104,255,.12)}.e01-number{font-size:clamp(90px,16vw,180px);font-weight:950;text-shadow:0 0 40px rgba(149,104,255,.6)}.e01-summary{text-align:center}.e01-summary h2{font-size:clamp(38px,5vw,68px);margin:0}.e01-summary p{max-width:700px;margin:14px auto;color:#bbb5c6;line-height:1.6}.waiting{color:#a9a4b2}@media(max-width:820px){.e01-naya{grid-template-columns:auto 1fr}.e01-listen{grid-column:1/-1;width:100%}}@media(max-width:520px){#e01{padding:12px 8px 50px}.e01-naya{grid-template-columns:1fr;text-align:center;padding:22px 16px}.e01-avatar{width:88px;height:88px;margin:auto}.e01-sub{font-size:15px}.e01-score{margin-top:32px;width:min(390px,100%)}}@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}</style></head><body><section id="e01"><div class="e01-shell"><div class="e01-naya"><img class="e01-avatar" src="https://raw.githubusercontent.com/SoulSchoolAcademy/MaxRESULTS/main/Naya%20Profile%206.jpg" alt="Naya"><div><div class="e01-kicker">NAYA · YOUR RESULT GUIDE</div><h1 class="e01-title">Hi. I’ve looked at your results.</h1><div class="e01-sub">This isn’t your judgment. It’s your map. Your score shows your current AI capability and where your next gains are available.</div></div><button class="e01-listen" id="e01-listen">LISTEN TO NAYA</button></div><div class="e01-score"><div class="e01-number" id="e01-number">—</div></div><div class="e01-summary"><h2 id="e01-band">AWAITING RESULT</h2><p id="e01-copy" class="waiting">MAXESS is waiting for your real assessment result. No score is invented here.</p></div></div></section><script>'use strict';
function readResult(){const c=[];try{c.push(window.MAXESS_RESULT)}catch(e){}try{if(window.parent&&window.parent!==window)c.push(window.parent.MAXESS_RESULT)}catch(e){}try{if(window.top&&window.top!==window)c.push(window.top.MAXESS_RESULT)}catch(e){}for(const r of c)if(r&&r.contractVersion==='MAXESS_RESULT_V1')return r;for(const store of [sessionStorage,localStorage])try{const r=JSON.parse(store.getItem('MAXESS_RESULT_V1')||'null');if(r&&r.contractVersion==='MAXESS_RESULT_V1')return r}catch(e){}try{const raw=new URLSearchParams(location.hash.replace(/^#/,'' )).get('maxess-result');if(raw){const s=raw.replace(/-/g,'+').replace(/_/g,'/');const bin=atob(s.padEnd(s.length+((4-s.length%4)%4),'='));const r=JSON.parse(new TextDecoder().decode(Uint8Array.from(bin,c=>c.charCodeAt(0))));if(r&&r.contractVersion==='MAXESS_RESULT_V1')return r}}catch(e){}return null}function onResult(fn){fn(readResult());['MAXESS_RESULT_READY','maxess:result-updated','storage','hashchange'].forEach(n=>window.addEventListener(n,e=>fn(e&&e.detail||readResult())));let i=0;const t=setInterval(()=>{fn(readResult());if(readResult()||++i>40)clearInterval(t)},250)}const bands={foundation:'EMERGING',developing:'DEVELOPING',advancing:'ADVANCING',mastery:'MASTERING'};function render(r){const n=document.getElementById('e01-number'),b=document.getElementById('e01-band'),c=document.getElementById('e01-copy');if(!r){n.textContent='—';b.textContent='AWAITING RESULT';c.textContent='MAXESS is waiting for your real assessment result. No score is invented here.';return}const s=Number(r.overallScore);if(!Number.isFinite(s)){n.textContent='—';b.textContent='INVALID RESULT';c.textContent='MAXESS received data, but the overall score is not valid.';return}n.textContent=Math.round(s);b.textContent=bands[r.masteryBand]||'RESULT';c.textContent='Your real MAXESS score is '+Math.round(s)+' out of 100. This is your starting point for understanding what to strengthen next.'}onResult(render);document.getElementById('e01-listen').onclick=()=>{const r=readResult();try{speechSynthesis.cancel();speechSynthesis.speak(new SpeechSynthesisUtterance(r?'Your MAXESS score is '+Math.round(r.overallScore)+' out of 100. Your current stage is '+(bands[r.masteryBand]||r.masteryBand)+'.':'Your MAXESS result is not available yet.'))}catch(e){}};</script></body></html>