<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="#000"><title>MAXESS — E03</title><style>#e03{min-height:100vh;background:#000;color:#fff;font-family:Inter,system-ui,sans-serif;padding:70px 20px 100px;box-sizing:border-box}#e03 *{box-sizing:border-box}.e03-shell{width:min(880px,100%);margin:auto}.e03-head{text-align:center}.e03-kicker{font-size:10px;letter-spacing:.3em;color:#aaa3b5}.e03-title{font:400 clamp(42px,6vw,76px)/.98 Georgia,serif;margin:18px 0}.e03-stage{font-size:10px;letter-spacing:.2em;color:#cbb7e8}.e03-letter{margin:65px auto 0;font:clamp(18px,2vw,23px)/1.8 Georgia,serif;color:#ddd9e5}.e03-letter p{margin:0 0 1.2em}.e03-pause{text-align:center;padding:30px 10px;border-top:1px solid rgba(255,255,255,.14);border-bottom:1px solid rgba(255,255,255,.14);color:#fff;font-size:clamp(27px,3.6vw,43px);line-height:1.2}.e03-sign{margin-top:65px;text-align:right;border-top:1px solid rgba(255,255,255,.1);padding-top:25px;color:#d7bfff;font:italic 36px "Brush Script MT",cursive}@media(max-width:720px){#e03{padding:48px 18px 75px}.e03-letter{margin-top:50px;font-size:18px;line-height:1.75}}@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}</style></head><body><section id="e03"><div class="e03-shell"><header class="e03-head"><div class="e03-kicker">MAXESS · PERSONAL REPORT</div><h2 class="e03-title">Your Personal Report</h2><div class="e03-stage" id="e03-stage">AWAITING YOUR MAXESS RESULT</div></header><article class="e03-letter" id="e03-letter"><p>MAXESS is waiting for your real assessment result. No score or narrative is invented here.</p></article><div class="e03-sign">Naya</div></div></section><script>'use strict';
function readResult(){const c=[];try{c.push(window.MAXESS_RESULT)}catch(e){}try{if(window.parent&&window.parent!==window)c.push(window.parent.MAXESS_RESULT)}catch(e){}try{if(window.top&&window.top!==window)c.push(window.top.MAXESS_RESULT)}catch(e){}for(const r of c)if(r&&r.contractVersion==='MAXESS_RESULT_V1')return r;for(const store of [sessionStorage,localStorage])try{const r=JSON.parse(store.getItem('MAXESS_RESULT_V1')||'null');if(r&&r.contractVersion==='MAXESS_RESULT_V1')return r}catch(e){}try{const raw=new URLSearchParams(location.hash.replace(/^#/,'' )).get('maxess-result');if(raw){const s=raw.replace(/-/g,'+').replace(/_/g,'/');const bin=atob(s.padEnd(s.length+((4-s.length%4)%4),'='));const r=JSON.parse(new TextDecoder().decode(Uint8Array.from(bin,c=>c.charCodeAt(0))));if(r&&r.contractVersion==='MAXESS_RESULT_V1')return r}}catch(e){}return null}function onResult(fn){fn(readResult());['MAXESS_RESULT_READY','maxess:result-updated','storage','hashchange'].forEach(n=>window.addEventListener(n,e=>fn(e&&e.detail||readResult())));let i=0;const t=setInterval(()=>{fn(readResult());if(readResult()||++i>40)clearInterval(t)},250)}const narratives={foundation:["I've looked at your results, and you're currently in the Foundation stage.","This is not a judgment. It means you're building the fundamentals that allow AI to work at a higher level for you.","Your opportunity is to become clearer about direction, context, evaluation, collaboration, and iteration.","You do not need to become more technical. You need a better way to work with the intelligence already available to you.","Direct. Ask. Look. Score. Improve. Repeat.","You already have the beginning. Now let's build on it."],developing:["I've looked at your results, and you're currently in the Developing stage.","You've already discovered that AI can do much more than simply answer a question.","Your next level is consistency: giving AI clear direction, useful context, thoughtful feedback, and deliberate evaluation.","Exceptional results do not have to happen by accident. They can become repeatable.","You're closer than you may realize."],advancing:["I've looked at your results, and you're currently in the Advancing stage.","You already know how to work with AI. You can direct it, recognize useful output, and shape the process.","Your biggest gains now come from becoming more deliberate: better direction, evaluation, refinement, and consistency.","There is a difference between getting an impressive result occasionally and producing exceptional results reliably.","That's where your next level begins."],mastery:["I've looked at your results, and you're currently in the Mastery stage.","You've developed the ability to work with AI deliberately, critically, and creatively.","You understand that exceptional results come from the thinking, direction, evaluation, and refinement behind them.","The question now is whether you can make exceptional results repeatable and turn capability into systems that compound.","You've built the capability. Now let's turn it into something extraordinary."]};function render(r){const st=document.getElementById('e03-stage'),letter=document.getElementById('e03-letter');if(!r){st.textContent='AWAITING YOUR MAXESS RESULT';letter.innerHTML='<p>MAXESS is waiting for your real assessment result. No score or narrative is invented here.</p>';return}const band=r.masteryBand;if(!narratives[band]){st.textContent='INVALID RESULT';letter.innerHTML='<p>MAXESS received data, but the mastery stage is not valid.</p>';return}st.textContent=band.toUpperCase()+' STAGE · SCORE '+Math.round(Number(r.overallScore));letter.innerHTML=narratives[band].map((x,i)=>i===4?'<div class="e03-pause">'+x+'</div>':'<p>'+x+'</p>').join('')}onResult(render);</script></body></html>